##   │ ├ Edge                                                {{{3
DestroyFunc ToggleEdgeScroll
AddToFunc ToggleEdgeScroll
+ I Test (EnvMatch EDGE_SCROLL on) EdgeResistance -1
+ I TestRc (Match) Exec exec notify-send -t 1000 -a Fvwm "Edge scroll disabled"
+ I TestRc (Match) SetEnv EDGE_SCROLL off
+ I TestRc (Match) Break
+ I EdgeResistance 0
+ I Exec exec notify-send -t 1000 -a Fvwm "Edge scroll enabled."
+ I SetEnv EDGE_SCROLL on
