##   │ ├ Automatic tiling                                   {{{3
# State 11 = tiled, 12 = floating, 13 = master, 15 = temporary exclusion.
DestroyFunc TileEventAdd
AddToFunc TileEventAdd
+ I TileAdmit $0

DestroyFunc TileEventRemove
AddToFunc TileEventRemove
+ I ThisWindow State 11 False
+ I ThisWindow State 13 False
+ I TileQueueArrange

DestroyFunc TileEventChange
AddToFunc TileEventChange
+ I TileQueueArrange

DestroyFunc TileQueueArrange
AddToFunc TileQueueArrange
+ I Test (EnvMatch TILE_BUSY yes) Break
+ I Deschedule 9902
+ I Schedule 75 9902 TileArrange

DestroyFunc TileAdmit
AddToFunc TileAdmit
+ I Test (!EnvMatch TILING_$[desk.n]-$[page.nx]-$[page.ny] on) Break
+ I WindowId $0 (CurrentPage, AcceptsFocus, !Transient, !State 12, !State 14) KeepRc \
    All (CurrentPage, State 13) State 13 False
+ I TestRc (NoMatch) Break
+ I WindowId $0 State 13 True
+ I TileArrange

DestroyFunc TileEnsureMaster
AddToFunc TileEnsureMaster
+ I All (CurrentPage, State 13, State 14) State 13 False
+ I None (CurrentPage, !Iconic, AcceptsFocus, !Transient, !State 12, !State 14, State 13) \
    Prev (CurrentPage, !Iconic, AcceptsFocus, !Transient, !State 12, !State 14) \
    State 13 True

DestroyFunc TileArrange
AddToFunc TileArrange
+ I Test (!EnvMatch TILING_$[desk.n]-$[page.nx]-$[page.ny] on) Break
+ I TileEnsureMaster
+ I All (CurrentPage, !Iconic, AcceptsFocus, !Transient, !State 12, !State 14, State 13) \
    State 11 True
+ I None (CurrentPage, !Iconic, AcceptsFocus, !Transient, !State 12, !State 13, !State 14) \
    KeepRc TileArrangeSolo
+ I TestRc (Match) Break
+ I All (CurrentPage, State 13) ResizeMoveMaximize frame \
    $[TILE_MASTER_PERCENT]wa 100wa 0 0
+ I All (CurrentPage, State 12, !StickyAcrossPages) State 15 True
+ I All (CurrentPage, State 13, !StickyAcrossPages) State 15 True
+ I All (CurrentPage, State 14, !StickyAcrossPages) State 15 True
+ I All (CurrentPage, State 15) WindowStyle StickyAcrossPages
+ I UpdateStyles
+ I SetEnv TILE_BUSY yes
+ I ModuleSynchronous FvwmRearrange -tile -swap -fill_start -on_screen \
    -noraise -maximize -order_yx -win_cmd "State 11 True" \
    $[TILE_MASTER_PERCENT] 0 100 100
# FvwmRearrange's handshake makes fvwm resend page info to FvwmEvent,
# read as a spurious new_page tens of ms after this call returns --
# TILE_BUSY has to outlive ModuleSynchronous, not clear right after it.
+ I Deschedule 9903
+ I Schedule 250 9903 SetEnv TILE_BUSY no
+ I All (CurrentPage, State 15) WindowStyle !StickyAcrossPages
+ I All (CurrentPage, State 15) State 15 False
+ I UpdateStyles

DestroyFunc TileArrangeSolo
AddToFunc TileArrangeSolo
+ I All (CurrentPage, State 13) ResizeMoveMaximize frame 100wa 100wa 0 0

DestroyFunc TileToggle
AddToFunc TileToggle
+ I Test (EnvMatch TILING_$[desk.n]-$[page.nx]-$[page.ny] on) \
    KeepRc TileDisable
+ I TestRc (Match) Break
+ I SetEnv TILING_$[desk.n]-$[page.nx]-$[page.ny] on
+ I All (CurrentPage, State 13) State 13 False
+ I Current (CurrentPage, !Iconic, AcceptsFocus, !Transient, !State 12, !State 14) \
    State 13 True
+ I TileArrange

DestroyFunc TileDisable
AddToFunc TileDisable
+ I SetEnv TILING_$[desk.n]-$[page.nx]-$[page.ny] off
+ I All (CurrentPage, State 11) Maximize False
+ I All (CurrentPage, State 11) State 11 False
+ I All (CurrentPage, State 13) State 13 False

