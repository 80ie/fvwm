##  ShelfMenu rows, top to bottom: the collapsible launcher accordion.
##  Rendered by bin/mk-shelf from the Shelf section of the config, and again on
##  every group toggle.
##
##  Nothing in this file may Swallow.  ShelfMenu swaps between two aliases on
##  every toggle, and during the swap the outgoing instance still holds any
##  swallowed window reparented inside it, so the incoming instance cannot
##  find it and Swallow's UseOld spawns a duplicate that ends up stranded on
##  the desktop.  Swallowed things belong in shelfdock.items.
##
##  Format:
##
##    group <Name> [Label]    starts a collapsible group.  mk-shelf draws the
##                            -/+ header row itself and binds it to
##                            ShelfToggle.  <Name> is the handle used in the
##                            state file, so it cannot contain spaces; the
##                            rest of the line, if any, is the visible label.
##
##    <height> <options>      a row inside the current group.  <height> is a
##                            pixel count or "flex[:weight]"; everything after
##                            it is passed to FvwmButtons untouched.
##
##    \                       at end of line, continues onto the next
##
##    %KEY%                   substituted by mk-shelf --define, for a height
##                            that is only known at runtime.
##
##    * <option>               a module-wide "*Shelf: <option>" line, emitted
##                            verbatim.  These live here rather than in config
##                            because mk-shelf reissues DestroyModuleConfig on
##                            every render and would wipe them.
##
##    endgroup                ends the current group, so the rows that follow
##                            are always shown.  A row that has to survive
##                            every collapse -- the filler below, a clock --
##                            needs this, or it belongs to the group above it
##                            and vanishes with it.
##
##  Rows outside any group are always shown, with no header above them.
##
##  Icons are drawn at their native size -- FvwmButtons does not scale them --
##  so every icon named here is one of the genuinely 16x16 files in
##  images/icons.  The unprefixed ones (terminal.png, files.png, apps.png,
##  monitor.png) are 18, 32 and 64px and shove the label sideways; browser.png
##  is a dangling symlink.  Check with "magick identify" before adding a row.
##
##  Heights have to add up: the shelf's pixel height is fixed by the screen,
##  so put at least one "flex" row in or mk-shelf will warn that the rows do
##  not fill it.  Note the flex row is sized for the *current* expansion
##  state, which is the whole point -- collapsing a group grows the filler.

##  Module-wide defaults.  Per-row Colorset/Frame below win over these; these
##  cover the window background and the gaps between rows.
* Colorset $[infostore.cs_shelf]
* ActiveColorset $[infostore.cs_shelf_hi]
* Frame 0
* Font $[infostore.shelf_font]
* Padding 4 0

group Applications
25   Icon "$[FVWM_ICON]/16x16-xterm-color.png", Title(Side,Left) "Terminal", \
     Action(Mouse 1) Exec exec $[infostore.terminal], \
     Colorset $[infostore.cs_shelf], ActiveColorset $[infostore.cs_shelf_hi], \
     Frame 0
25   Icon "$[FVWM_ICON]/16x16-firefox.png", Title(Side,Left) "Browser", \
     Action(Mouse 1) Exec exec firefox, \
     Colorset $[infostore.cs_shelf], ActiveColorset $[infostore.cs_shelf_hi], \
     Frame 0
25   Icon "$[FVWM_ICON]/16x16-Explorer++.png", Title(Side,Left) "File Manager", \
     Action(Mouse 1) Exec exec $[infostore.filemanager], \
     Colorset $[infostore.cs_shelf], ActiveColorset $[infostore.cs_shelf_hi], \
     Frame 0
25   Icon "$[FVWM_ICON]/16x16-org.speedcrunch.SpeedCrunch.png", \
     Title(Side,Left) "Calculator", \
     Action(Mouse 1) Exec exec $[infostore.calculator], \
     Colorset $[infostore.cs_shelf], ActiveColorset $[infostore.cs_shelf_hi], \
     Frame 0
25   Icon "$[FVWM_ICON]/16x16-emacs.png", Title(Side,Left) "Editor", \
     Action(Mouse 1) Exec exec emacs, \
     Colorset $[infostore.cs_shelf], ActiveColorset $[infostore.cs_shelf_hi], \
     Frame 0

group Utilities
25   Icon "$[FVWM_ICON]/16x16-qps.png", Title(Side,Left) "Process Monitor", \
     Action(Mouse 1) Exec exec $[infostore.terminal] -e btop, \
     Colorset $[infostore.cs_shelf], ActiveColorset $[infostore.cs_shelf_hi], \
     Frame 0
25   Icon "$[FVWM_ICON]/16x16-org.flameshot.Flameshot.png", \
     Title(Side,Left) "Screenshot", \
     Action(Mouse 1) Exec exec flameshot gui, \
     Colorset $[infostore.cs_shelf], ActiveColorset $[infostore.cs_shelf_hi], \
     Frame 0
25   Icon "$[FVWM_ICON]/16x16-qlipper.png", Title(Side,Left) "Clipboard", \
     Action(Mouse 1) Exec exec qlipper, \
     Colorset $[infostore.cs_shelf], ActiveColorset $[infostore.cs_shelf_hi], \
     Frame 0

group Configure
25   Icon "$[FVWM_ICON]/16x16-nvidia-settings.png", Title(Side,Left) "Graphics", \
     Action(Mouse 1) Exec exec arandr, \
     Colorset $[infostore.cs_shelf], ActiveColorset $[infostore.cs_shelf_hi], \
     Frame 0
25   Icon "$[FVWM_ICON]/16x16-xscreensaver.png", Title(Side,Left) "Screen Saver", \
     Action(Mouse 1) Exec exec xscreensaver-demo, \
     Colorset $[infostore.cs_shelf], ActiveColorset $[infostore.cs_shelf_hi], \
     Frame 0
25   Icon "$[FVWM_ICON]/16x16-menulibre.png", Title(Side,Left) "Appearance", \
     Action(Mouse 1) Exec exec $[infostore.terminal] -e \
         $EDITOR $[FVWM_USERDIR]/config, \
     Colorset $[infostore.cs_shelf], ActiveColorset $[infostore.cs_shelf_hi], \
     Frame 0

endgroup

##  Sunken filler.  ShelfMenu's height is fixed -- screen minus taskbar minus
##  the dock -- so this is what absorbs the pixels a collapsed group gives
##  back, and what keeps the accordion reaching down to the dock.  It sits
##  after "endgroup" so that collapsing Configure does not take it along.
flex Frame -1, Colorset $[infostore.cs_shelf_well]
