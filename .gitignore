# fvwm-crystal thumbnail cache (regenerated on demand)
.thumbs
**/.thumbs/
icons
images
doc
.idea
.vscode
# Auto-generated XDG application menu
.XDGMenu
.FvwmForm-XDGMenu-Config

# Per-session restart/state files written by fvwm
.fs-restart-*

# Interactive FvwmConsole command history
.FvwmConsole-History

# Pre-save backup written by bin/fvwm-keys
bindings.bak

archive

# Vendored upstream fvwm documentation lives in doc/ (singular), ignored above.
# docs/ (plural) is ours and is tracked -- except for the copy of that same
# upstream manual and wiki that also sits under it.
docs/Man/
docs/Wiki/

# Runtime shelf width and collapse state, written by bin/shelf-panel
.panel.state

# Python bytecode cache from the shelf widgets
__pycache__/

# Agent session artifacts
.pi/
