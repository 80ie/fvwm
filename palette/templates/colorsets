{% include "roles.j2" %}## vim: sts=0:noet:syntax=fvwm
## Generated by bin/palette from palette/templates/colorsets; edit that instead.

InfoStoreAdd cs_shelf        30
InfoStoreAdd cs_shelf_hi     31
InfoStoreAdd cs_shelf_header 32
InfoStoreAdd cs_shelf_well   33

SetEnv FVWM_PHOTON_FACE         "{{ face }}"
SetEnv FVWM_PHOTON_FACE_HI      "{{ face_hi }}"
SetEnv FVWM_PHOTON_HEADER       "{{ header }}"
SetEnv FVWM_PHOTON_GUTTER       "{{ gutter }}"
SetEnv FVWM_PHOTON_FRAME_MID    "{{ frame_mid }}"
SetEnv FVWM_PHOTON_WELL         "{{ well }}"
SetEnv FVWM_PHOTON_FACE_ALT     "{{ face_alt }}"
SetEnv FVWM_PHOTON_BTN_HI       "{{ btn_hi }}"
SetEnv FVWM_PHOTON_BTN_LO       "{{ btn_lo }}"
SetEnv FVWM_PHOTON_WELL_SH      "{{ well_sh }}"
SetEnv FVWM_PHOTON_WELL_LIP     "{{ well_lip }}"
SetEnv FVWM_PHOTON_HI           "{{ hi }}"
SetEnv FVWM_PHOTON_SH           "{{ sh }}"
SetEnv FVWM_PHOTON_DARK         "{{ dark }}"
SetEnv FVWM_PHOTON_HEADER_CELL  "{{ header_cell }}"
SetEnv FVWM_PHOTON_HEADER_GLYPH "{{ header_glyph }}"
SetEnv FVWM_PHOTON_FIELD        "{{ field }}"
SetEnv FVWM_PHOTON_TROUGH       "{{ trough }}"
SetEnv FVWM_PHOTON_TROUGH_SH    "{{ trough_sh }}"
SetEnv FVWM_PHOTON_GROOVE       "{{ groove }}"
SetEnv FVWM_PHOTON_GROOVE_MID   "{{ groove_mid }}"
SetEnv FVWM_PHOTON_GROOVE_HI    "$[FVWM_PHOTON_GUTTER]"
SetEnv FVWM_PHOTON_GROOVE_LIP   "$[FVWM_PHOTON_BTN_HI]"
SetEnv FVWM_PHOTON_THUMB_HI     "{{ thumb_hi }}"
SetEnv FVWM_PHOTON_THUMB_LO     "$[FVWM_PHOTON_HEADER_CELL]"
SetEnv FVWM_PHOTON_TICK_HI      "$[FVWM_PHOTON_BTN_LO]"
SetEnv FVWM_PHOTON_TICK_LO      "{{ tick_lo }}"
SetEnv FVWM_PHOTON_FILL_CPU     "{{ fill_cpu }}"
SetEnv FVWM_PHOTON_FILL_MEM     "{{ fill_mem }}"
SetEnv FVWM_PHOTON_INK          "{{ ink }}"
SetEnv FVWM_PHOTON_INK_OFF      "$[FVWM_PHOTON_GROOVE]"
SetEnv FVWM_PHOTON_PAGER_SECTION "$[FVWM_PHOTON_WELL_SH]"
SetEnv FVWM_PHOTON_PAGER_DESK    "{{ pager_desk }}"
SetEnv FVWM_PHOTON_PAGER_DESK_HI "{{ pager_desk_hi }}"
SetEnv FVWM_PHOTON_PAGER_WIN     "{{ pager_win }}"
SetEnv FVWM_PHOTON_PAGER_WIN_EDGE "{{ pager_win_edge }}"
SetEnv FVWM_PHOTON_PAGER_FOCUS    "{{ pager_focus }}"
SetEnv FVWM_PHOTON_PAGER_FOCUS_EDGE "{{ pager_focus_edge }}"
SetEnv FVWM_PHOTON_PAGER_GRID       "$[FVWM_PHOTON_HI]"
SetEnv FVWM_PHOTON_FILL_DISK        "$[FVWM_PHOTON_PAGER_DESK]"

# Window frame and title colors are pinned in `config`; their former
# colorsets (0 - 4: window/border decor, 15: close button face) are no
# longer rendered here.
#~~~~~~~ 5 - Menu - Inactive Item
Colorset 5 fg {{ chrome_alert }}, bg {{ chrome_bg }}, hi, sh, Plain, NoShape
#~~~~~~~ 6 - Menu - Active Item
Colorset 6 fg {{ hi }}, bg {{ chrome_fg_dim }}, hi, sh, Plain, NoShape
#~~~~~~~ 7 - Menu - Grayed Item
Colorset 7 fg {{ hi }}, bg {{ chrome_bg_grey }}, hi, sh, Plain, NoShape
#~~~~~~~ 8 - Menu - Title
Colorset 8 fg {{ hi }}, bg {{ chrome_bg | darken(0.03) }}, hi, sh, Plain, NoShape

#~~~~~~~ 10 - Module Default [PlainColorset]
Colorset 10 fg {{ chrome_alert }}, bg {{ chrome_bg_dark }}, hi, sh, Plain, NoShape
#~~~~~~~ 11 - Module Hilight
Colorset 11 fg {{ chrome_accent }}, bg {{ chrome_bg_lift }}, hi, sh, Plain, NoShape
#~~~~~~~ 12 - Module ActiveButton (Mouse Hover)
Colorset 12 fg {{ chrome_alert }}, bg {{ chrome_accent | darken(0.68) }}, hi, sh, Plain, NoShape
#~~~~~~~ 13 - FvwmPager Active Page
Colorset 13 fg {{ chrome_alert }}, bg {{ chrome_bg }}, hi, sh, Plain, NoShape
#~~~~~~~ 14 - FvwmIconMan Iconified Button
Colorset 14 fg {{ chrome_alert }}, bg {{ chrome_bg_dark }}, hi, sh, Plain, NoShape

#~~~~~~~ 16 - FvwmPager Default
Colorset 16 fg {{ chrome_fg_dim }}, bg {{ chrome_bg_lift }}, hi, sh, Plain, NoShape
#~~~~~~~ 17 - FvwmPager Page Highlight
Colorset 17 fg {{ chrome_rust }}, bg {{ chrome_alert }}, hi, sh, Plain, NoShape
#~~~~~~~ 18 - FvwmPager Window Highlight
Colorset 18 fg {{ chrome_rust }}, bg {{ chrome_accent | darken(0.64) }}, hi, sh, Plain, NoShape
#~~~~~~~ 19 - FvwmPager Window Default
Colorset 19 fg {{ chrome_accent | darken(0.72) }}, bg {{ chrome_fg | darken(0.4) }}, hi, sh, Plain, NoShape

# 20 - FvwmPager Active Page, 21 - Default: wallpaper tiled once per
# page; re-cut to one page cell by bin/photon_pager.py on every launch.
Colorset 20 fg Contrast, bg Average, hi, sh, TiledPixmap $[infostore.pager_bg], Tint {{ chrome_rust }} 35, Dither
Colorset 21 fg Contrast, bg Average, hi, sh, TiledPixmap $[infostore.pager_bg], Tint {{ chrome_bg }} 10, Dither

# 30-37: QNX Photon shelf and pager
Colorset 30 fg $[FVWM_PHOTON_INK], bg $[FVWM_PHOTON_FACE], hi $[FVWM_PHOTON_HI], sh $[FVWM_PHOTON_SH], Plain, NoShape
Colorset 31 fg $[FVWM_PHOTON_INK], bg $[FVWM_PHOTON_FACE_HI], hi $[FVWM_PHOTON_HI], sh $[FVWM_PHOTON_SH], Plain, NoShape
Colorset 32 fg $[FVWM_PHOTON_INK], bg $[FVWM_PHOTON_HEADER], hi $[FVWM_PHOTON_HI], sh $[FVWM_PHOTON_SH], Plain, NoShape
Colorset 33 fg $[FVWM_PHOTON_INK], bg $[FVWM_PHOTON_WELL], hi $[FVWM_PHOTON_HI], sh $[FVWM_PHOTON_SH], Plain, NoShape
Colorset 34 fg $[FVWM_PHOTON_PAGER_GRID], bg $[FVWM_PHOTON_PAGER_DESK], hi $[FVWM_PHOTON_HI], sh $[FVWM_PHOTON_SH], Plain, NoShape
Colorset 35 fg $[FVWM_PHOTON_PAGER_GRID], bg $[FVWM_PHOTON_PAGER_DESK_HI], hi $[FVWM_PHOTON_HI], sh $[FVWM_PHOTON_SH], Plain, NoShape
Colorset 36 fg $[FVWM_PHOTON_INK], bg $[FVWM_PHOTON_PAGER_WIN], hi $[FVWM_PHOTON_HI], sh $[FVWM_PHOTON_PAGER_WIN_EDGE], Plain, NoShape
Colorset 37 fg $[FVWM_PHOTON_INK], bg $[FVWM_PHOTON_PAGER_FOCUS], hi $[FVWM_PHOTON_HI], sh $[FVWM_PHOTON_PAGER_FOCUS_EDGE], Plain, NoShape
