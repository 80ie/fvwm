--  System Monitor meters for the QNX Photon shelf.
--
--  Swallowed by FvwmButtons from the SysMon group in shelf.items, which hangs
--  on the window title set below.  Nothing else should run this file: the
--  geometry is sized for the shelf's inner width and it has no decorations of
--  its own.
--
--  Three rows -- CPU, memory, filesystem -- matching the three icon+bar rows
--  of the Photon widget.  Conky draws a bar's outline and its fill in the
--  same colour, so the sunken trough around each bar that the screenshot has
--  is not reachable from here; the whole block sits in one sunken FvwmButtons
--  cell instead.  Per-bar troughs would need conky's Lua/cairo drawing hook.

conky.config = {
    --  A normal window, so FvwmButtons can reparent it.  own_window_title is
    --  the string the Swallow in shelf.items waits for.
    own_window            = true,
    own_window_type       = 'normal',
    own_window_class      = 'ShelfMeters',
    own_window_title      = 'ShelfMeters',
    own_window_colour     = 'd2d2d2',
    own_window_transparent = false,
    own_window_hints      = 'undecorated,below,sticky,skip_taskbar,skip_pager',

    --  Fixed to the shelf's inner width.  Keep in step with shelf_inner in
    --  the Shelf section of the config; the height here is what the SysMon
    --  row in shelf.items reserves.
    minimum_width  = 152,
    maximum_width  = 152,
    minimum_height = 58,

    --  Essential: without it every update repaints visibly, which on a panel
    --  that redraws every two seconds reads as a permanent flicker.
    double_buffer = true,

    update_interval = 2,

    use_xft       = true,
    font          = 'Sans:size=7',
    default_color = '3c3c3c',
    draw_shades   = false,
    draw_outline  = false,
    draw_borders  = false,

    border_inner_margin = 3,
    border_outer_margin = 0,
    gap_x = 0,
    gap_y = 0,
    alignment = 'top_left',

    --  Conky is told the bar size per-bar below; these are the fallbacks.
    default_bar_width  = 112,
    default_bar_height = 9,

    --  No shell-outs: everything here is a built-in reader, so the two-second
    --  update costs nothing.
    no_buffers = true,
    out_to_console = false,
}

conky.text = [[
CPU ${alignr}${cpubar cpu0 9,112}
MEM ${alignr}${membar 9,112}
DSK ${alignr}${fs_bar 9,112 /}
]]
