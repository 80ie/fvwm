#  ---- Widgets 6-8: volume --------------------------------------------------
#  The readout is refreshed from wpctl after the click rather than from a
#  counter kept here, so it cannot drift out of step with the real sink.
Widget 6
Property
 Position 0 46
 Size 30 22
 Type PushButton
 Title {-}
Main
 Case message of
  SingleClic :
  Begin
   Do {Exec exec /home/deer/.fvwm/bin/shelf-media vol-down}
   Set $Vol = (GetOutput {/home/deer/.fvwm/bin/shelf-media vol} 1 -1)
   ChangeTitle 7 $Vol
  End
 End

Widget 7
Property
 Position 30 46
 Size 92 22
 Type ItemDraw
 Flags NoReliefString
 Title {}
Main
 Case message of
  SingleClic :
  Begin
  End
 End

