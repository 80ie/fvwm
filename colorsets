## vim: sts=0:noet:syntax=fvwm
## Generated by bin/palette from palette/templates/colorsets; edit that instead.

InfoStoreAdd cs_shelf        30
InfoStoreAdd cs_shelf_hi     31
InfoStoreAdd cs_shelf_header 32
InfoStoreAdd cs_shelf_well   33

SetEnv FVWM_PHOTON_FACE         "#a2948a"
SetEnv FVWM_PHOTON_FACE_HI      "#bdb3ac"
SetEnv FVWM_PHOTON_HEADER       "#a79990"
SetEnv FVWM_PHOTON_GUTTER       "#988b82"
SetEnv FVWM_PHOTON_FRAME_MID    "#7c716a"
SetEnv FVWM_PHOTON_WELL         "#9a8d83"
SetEnv FVWM_PHOTON_FACE_ALT     "#a19389"
SetEnv FVWM_PHOTON_BTN_HI       "#cec6c1"
SetEnv FVWM_PHOTON_BTN_LO       "#837870"
SetEnv FVWM_PHOTON_WELL_SH      "#8f837a"
SetEnv FVWM_PHOTON_WELL_LIP     "#ac9f96"
SetEnv FVWM_PHOTON_HI           "#c8c1bc"
SetEnv FVWM_PHOTON_SH           "#70645b"
SetEnv FVWM_PHOTON_DARK         "#322d29"
SetEnv FVWM_PHOTON_HEADER_CELL  "#95887f"
SetEnv FVWM_PHOTON_HEADER_GLYPH "#48413d"
SetEnv FVWM_PHOTON_FIELD        "#e4e0dd"
SetEnv FVWM_PHOTON_TROUGH       "#8c8078"
SetEnv FVWM_PHOTON_TROUGH_SH    "#69605a"
SetEnv FVWM_PHOTON_GROOVE       "#685f59"
SetEnv FVWM_PHOTON_GROOVE_MID   "#80756d"
SetEnv FVWM_PHOTON_GROOVE_HI    "$[FVWM_PHOTON_GUTTER]"
SetEnv FVWM_PHOTON_GROOVE_LIP   "$[FVWM_PHOTON_BTN_HI]"
SetEnv FVWM_PHOTON_THUMB_HI     "#dad5d1"
SetEnv FVWM_PHOTON_THUMB_LO     "$[FVWM_PHOTON_HEADER_CELL]"
SetEnv FVWM_PHOTON_TICK_HI      "$[FVWM_PHOTON_BTN_LO]"
SetEnv FVWM_PHOTON_TICK_LO      "#514a45"
SetEnv FVWM_PHOTON_FILL_CPU     "#141300"
SetEnv FVWM_PHOTON_FILL_MEM     "#584a0c"
SetEnv FVWM_PHOTON_INK          "#020200"
SetEnv FVWM_PHOTON_INK_OFF      "$[FVWM_PHOTON_GROOVE]"
# ShelfPager (config: *ShelfPager: ...) reads these; each var below names
# the colorset it feeds. PAGE_HI is the active/current page (HilightColorset
# 20); FOCUS is the focused window swatch (FocusColorset 37).
SetEnv FVWM_PHOTON_PAGER_SECTION "$[FVWM_PHOTON_WELL_SH]"
SetEnv FVWM_PHOTON_PAGER_DESK    "#5c300e"      # bin/photon_pager.py WorldView bg (no fvwm Colorset)
SetEnv FVWM_PHOTON_PAGER_DESK_HI "#ae9886"   # unused by fvwm or shelf currently
SetEnv FVWM_PHOTON_PAGER_WIN     "#8f8279"       # colorset 36 bg: normal window swatch
SetEnv FVWM_PHOTON_PAGER_WIN_EDGE "#605751" # colorset 36 sh
SetEnv FVWM_PHOTON_PAGER_FOCUS    "#4c4c44"      # colorset 37 bg: focused/active window swatch
SetEnv FVWM_PHOTON_PAGER_FOCUS_EDGE "#33332e" # colorset 37 sh
SetEnv FVWM_PHOTON_PAGER_GRID       "$[FVWM_PHOTON_HI]"
SetEnv FVWM_PHOTON_FILL_DISK        "$[FVWM_PHOTON_PAGER_DESK]"
SetEnv FVWM_PHOTON_PAGER_PAGE       "#92857c"     # colorset 21 bg: default page
SetEnv FVWM_PHOTON_PAGER_PAGE_HI    "#bdb3ac"  # colorset 20 bg: active/current page

# Window decor: 40 inactive, 41 active (config's `Style *`), 15 close button.
# config can pin them back; its Colorset lines run after this file is read.
Colorset 40 fg #a2948a, bg #322d29, hi, sh, Plain, NoShape
Colorset 41 fg #e47434, bg #481f06, hi, sh, Plain, NoShape
Colorset 15 fg #e4e0dd, bg #e47434, hi, sh, Plain, NoShape

# Menus and modules take the Photon roles (the shelf's), so they follow the
# scheme. Active/hover is groove on field.
#~~~~~~~ 5 - Menu - Inactive Item
Colorset 5 fg $[FVWM_PHOTON_INK], bg $[FVWM_PHOTON_FACE], hi $[FVWM_PHOTON_BTN_HI], sh $[FVWM_PHOTON_BTN_LO], Plain, NoShape
#~~~~~~~ 6 - Menu - Active Item
Colorset 6 fg $[FVWM_PHOTON_FIELD], bg $[FVWM_PHOTON_GROOVE], hi $[FVWM_PHOTON_BTN_HI], sh $[FVWM_PHOTON_BTN_LO], Plain, NoShape
#~~~~~~~ 7 - Menu - Grayed Item
Colorset 7 fg $[FVWM_PHOTON_GROOVE_MID], bg $[FVWM_PHOTON_FACE], hi $[FVWM_PHOTON_BTN_HI], sh $[FVWM_PHOTON_BTN_LO], Plain, NoShape
#~~~~~~~ 8 - Menu - Title
Colorset 8 fg $[FVWM_PHOTON_INK], bg $[FVWM_PHOTON_HEADER_CELL], hi $[FVWM_PHOTON_BTN_HI], sh $[FVWM_PHOTON_BTN_LO], Plain, NoShape

#~~~~~~~ 10 - Module Default [PlainColorset]
Colorset 10 fg $[FVWM_PHOTON_INK], bg $[FVWM_PHOTON_FACE], hi $[FVWM_PHOTON_BTN_HI], sh $[FVWM_PHOTON_BTN_LO], Plain, NoShape
#~~~~~~~ 11 - Module Hilight
Colorset 11 fg $[FVWM_PHOTON_INK], bg $[FVWM_PHOTON_FACE_HI], hi $[FVWM_PHOTON_BTN_HI], sh $[FVWM_PHOTON_BTN_LO], Plain, NoShape
#~~~~~~~ 12 - Module ActiveButton (Mouse Hover)
Colorset 12 fg $[FVWM_PHOTON_FIELD], bg $[FVWM_PHOTON_GROOVE], hi $[FVWM_PHOTON_BTN_HI], sh $[FVWM_PHOTON_BTN_LO], Plain, NoShape
#~~~~~~~ 13 - FvwmFormDefault ItemColorset
Colorset 13 fg $[FVWM_PHOTON_INK], bg $[FVWM_PHOTON_FIELD], hi $[FVWM_PHOTON_BTN_HI], sh $[FVWM_PHOTON_BTN_LO], Plain, NoShape
#~~~~~~~ 14 - FvwmIconMan Iconified Button
Colorset 14 fg $[FVWM_PHOTON_INK], bg $[FVWM_PHOTON_WELL], hi $[FVWM_PHOTON_BTN_HI], sh $[FVWM_PHOTON_BTN_LO], Plain, NoShape

# 16-19: unused legacy FvwmPager palette, superseded by ShelfPager (20/21/36/37) below
#~~~~~~~ 16 - FvwmPager Default
Colorset 16 fg #4c4c44, bg #481f06, hi, sh, Plain, NoShape
#~~~~~~~ 17 - FvwmPager Page Highlight
Colorset 17 fg #3d1f04, bg #78340a, hi, sh, Plain, NoShape
#~~~~~~~ 18 - FvwmPager Window Highlight
Colorset 18 fg #3d1f04, bg #070700, hi, sh, Plain, NoShape
#~~~~~~~ 19 - FvwmPager Window Default
Colorset 19 fg #060500, bg #44443d, hi, sh, Plain, NoShape

# ShelfPager (config: *ShelfPager: Colorset/HilightColorset), the live shelf pager
#~~~~~~~ 20 - ShelfPager HilightColorset: active/current page
Colorset 20 fg $[FVWM_PHOTON_PAGER_GRID], bg $[FVWM_PHOTON_PAGER_PAGE_HI], hi, sh, Plain, NoShape
#~~~~~~~ 21 - ShelfPager Colorset: default page
Colorset 21 fg $[FVWM_PHOTON_PAGER_GRID], bg $[FVWM_PHOTON_PAGER_PAGE], hi, sh, Plain, NoShape


# 30-33: QNX Photon shelf chrome; 36-37: ShelfPager Window/FocusColorset (window swatches)
Colorset 30 fg $[FVWM_PHOTON_INK], bg $[FVWM_PHOTON_FACE], hi $[FVWM_PHOTON_HI], sh $[FVWM_PHOTON_SH], Plain, NoShape
Colorset 31 fg $[FVWM_PHOTON_INK], bg $[FVWM_PHOTON_FACE_HI], hi $[FVWM_PHOTON_HI], sh $[FVWM_PHOTON_SH], Plain, NoShape
Colorset 32 fg $[FVWM_PHOTON_INK], bg $[FVWM_PHOTON_HEADER], hi $[FVWM_PHOTON_HI], sh $[FVWM_PHOTON_SH], Plain, NoShape
Colorset 33 fg $[FVWM_PHOTON_INK], bg $[FVWM_PHOTON_WELL], hi $[FVWM_PHOTON_HI], sh $[FVWM_PHOTON_SH], Plain, NoShape
#~~~~~~~ 36 - ShelfPager WindowColorset: normal window swatch
Colorset 36 fg $[FVWM_PHOTON_INK], bg $[FVWM_PHOTON_PAGER_WIN], hi $[FVWM_PHOTON_HI], sh $[FVWM_PHOTON_PAGER_WIN_EDGE], Plain, NoShape
#~~~~~~~ 37 - ShelfPager FocusColorset: focused/active window swatch
Colorset 37 fg $[FVWM_PHOTON_INK], bg $[FVWM_PHOTON_PAGER_FOCUS], hi $[FVWM_PHOTON_HI], sh $[FVWM_PHOTON_PAGER_FOCUS_EDGE], Plain, NoShape
