SetEnv FVWM_PHOTON_WELL_SH      "#c0c0c0"
SetEnv FVWM_PHOTON_WELL_LIP     "#dddddd"
SetEnv FVWM_PHOTON_HI           "#ffffff"
SetEnv FVWM_PHOTON_SH           "#a7a7a7"
