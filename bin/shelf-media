#!/bin/bash

##  Backend for the shelf's Media widget: MPRIS transport plus sink volume.
##
##  Uses gdbus rather than playerctl so the shelf needs nothing installed --
##  gdbus ships with glib, which is already a hard dependency of everything
##  here.  The cost is finding the player by hand, which is the ListNames call
##  below; playerctl would do that for us.
##
##  Every subcommand is safe to run with no player on the bus.  The widget
##  polls this once a second, so a failure has to be quiet and fast: it prints
##  a placeholder and exits 0 rather than letting an error reach the panel.

set -u

MPRIS_PATH=/org/mpris/MediaPlayer2
MPRIS_IFACE=org.mpris.MediaPlayer2.Player

##  First MPRIS name on the session bus, or empty.  When several players are
##  running this picks whichever the bus lists first, which is arbitrary but
##  stable within a session; choosing the *playing* one would cost an extra
##  round trip per candidate on every poll.
player() {
    gdbus call --session \
        --dest org.freedesktop.DBus \
        --object-path /org/freedesktop/DBus \
        --method org.freedesktop.DBus.ListNames 2>/dev/null \
    | tr ",' " '\n\n\n' \
    | grep -m1 '^org\.mpris\.MediaPlayer2\.'
}

##  Read one property off the player interface.  gdbus prints variants as
##  "(<'value'>,)" so the quotes and wrapper have to come back off.
prop() {
    local p=$1 name=$2 out
    out=$(gdbus call --session --dest "$p" --object-path "$MPRIS_PATH" \
              --method org.freedesktop.DBus.Properties.Get \
              "$MPRIS_IFACE" "$name" 2>/dev/null) || return 1
    printf '%s' "$out" | sed -e "s/^(<'\\?//" -e "s/'\\?>,)$//"
}

call() {
    local p
    p=$(player) || return 0
    [ -n "$p" ] || return 0
    gdbus call --session --dest "$p" --object-path "$MPRIS_PATH" \
        --method "$MPRIS_IFACE.$1" >/dev/null 2>&1
    return 0
}

##  Metadata is a dict, so pull the two fields out of the printed form rather
##  than parsing it properly -- the widget only ever shows artist and title.
metadata_field() {
    local p=$1 key=$2
    gdbus call --session --dest "$p" --object-path "$MPRIS_PATH" \
        --method org.freedesktop.DBus.Properties.Get \
        "$MPRIS_IFACE" Metadata 2>/dev/null \
    | grep -o "'$key': <\[\?'[^']*'" \
    | sed -e "s/.*<\[\?'//" -e "s/'$//"
}

case ${1:-title} in
title)
    ##  One line for the widget's text field.  Never empty and never longer
    ##  than the field, because FvwmScript does not clip: an over-long title
    ##  would push the widget wider than the shelf.
    p=$(player)
    if [ -z "$p" ] ; then
        echo "No player"
    else
        artist=$(metadata_field "$p" xesam:artist)
        title=$(metadata_field "$p" xesam:title)
        if [ -n "$title" ] && [ -n "$artist" ] ; then out="$artist - $title"
        elif [ -n "$title" ]                      ; then out="$title"
        else out="${p##*.}"
        fi
        printf '%.24s\n' "$out"
    fi
    ;;
status)
    p=$(player)
    if [ -z "$p" ] ; then echo "-" ; else prop "$p" PlaybackStatus || echo "-" ; fi
    ;;
playpause) call PlayPause ;;
next)      call Next ;;
prev)      call Previous ;;
stop)      call Stop ;;
vol)
    ##  wpctl prints "Volume: 0.45"; the widget's slider is an integer 0-100,
    ##  and FvwmScript's arithmetic is integer only, so convert here.
    v=$(wpctl get-volume @DEFAULT_SINK@ 2>/dev/null | awk '{print $2}')
    [ -n "$v" ] || { echo 0 ; exit 0 ; }
    awk -v v="$v" 'BEGIN { p = int(v * 100 + 0.5) ; print (p > 100 ? 100 : p) }'
    ;;
vol-set)
    [ $# -ge 2 ] || exit 0
    wpctl set-volume @DEFAULT_SINK@ "$2%" >/dev/null 2>&1
    ;;
vol-up)
    ##  -l caps at 1.0 so a repeated click cannot push the sink above 100%,
    ##  which pipewire allows and which sounds terrible.
    wpctl set-volume -l 1.0 @DEFAULT_SINK@ 5%+ >/dev/null 2>&1
    ;;
vol-down)
    wpctl set-volume @DEFAULT_SINK@ 5%- >/dev/null 2>&1
    ;;
*)
    printf '%s: unknown subcommand %s\n' "${0##*/}" "$1" >&2
    exit 1
    ;;
esac
exit 0
