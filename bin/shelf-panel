#!/usr/bin/env python3
"""The QNX Photon shelf, drawn as one window.

This is option C from PANEL-DESIGN.md, for the sidebar.  It replaces
bin/mk-shelf, shelf.items, shelfdock.items, the ShelfMenuA/B alias swap and
.shelf.state with a single program that lays itself out at runtime.  It also
absorbs FvwmTaskBar now that that has been retired: the panel is full screen
height, and Windows/System Tray/clock sit in the stack alongside what used
to be swallowed widgets.

Three things become possible by leaving FvwmButtons behind, and they are the
reasons for doing it rather than side effects:

  - **The double bevel.**  The shelf's left edge is two nested bevels with a
    face channel between them.  `Frame N` draws one bevel N pixels wide out
    of a colorset's hi/sh and cannot nest, at any width.
  - **Live resizing.**  FvwmButtons cannot resize its grid, so a width
    change meant regenerating the module -- and a module restart is
    asynchronous with no "I am mapped" signal to sequence against, so the
    150ms kill timer was a race that dropped the shelf entirely on about one
    toggle in four (measured at 60fps).  Dragging the edge here is a
    relayout.  fvwm is told the new reserved width with EwmhBaseStruts,
    which does take effect at runtime -- checked by maximising a window
    across a strut change.
  - **Collapsing without restarting anything.**  Same reason: no module, no
    swap, no stranded duplicate.

Sections come from panel.items.  The drawn widgets are the same components
the dock swallowed before, imported rather than launched, which is what they
were written for.
"""

import json
import os
import shlex
import signal
import socket
import subprocess
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

os.environ.setdefault("QT_QPA_PLATFORMTHEME", "")
os.environ.setdefault("QT_LOGGING_RULES", "*.debug=false")

from PyQt6.QtCore import (QPoint, QProcess, QRect, QSocketNotifier, Qt,
                          QTimer)
from PyQt6.QtGui import (QCursor, QFontMetrics, QPainter, QPalette,
                         QPixmap)
from PyQt6.QtWidgets import QApplication, QWidget

import photon
from photon_clock import ClockWidget
from photon_media import MediaWidget
from photon_meters import MetersWidget
from photon_pager import WorldView
from photon_tasks import TasksWidget
from photon_tray import TrayWidget

USERDIR = os.environ.get("FVWM_USERDIR", os.path.expanduser("~/.fvwm"))
SPEC = os.path.join(USERDIR, "panel.items")
STATE = os.path.join(USERDIR, ".panel.state")
ICONS = os.path.join(USERDIR, "icons")

MIN_W, MAX_W = 110, 420
DEFAULT_W = 160

#  The reference does not run its widgets into the screen edge: sampled along
#  the System Monitor's meters, the trough's outline stops at x=196 and the
#  three columns after it are shelf face before the shelf's own last column.
#  Headers and the clock strip are the exception -- both go the full width.
PAD_R = 3

#  And it separates every section from the next with an etched rule, #a7a7a7
#  over #ffffff, which is photon.divider: at y=4,85,172 in the reference,
#  above System Monitor, above CD Player and above World View respectively.
SEP_H = 2


#  ---- Spec ------------------------------------------------------------

class Group:
    def __init__(self, label):
        self.label = label
        self.items = []       # (label, icon, command)
        self.widget = None    # name, for a drawn section
        self.collapsed = False
        self.bare = False     # no header at all -- see `bare` in panel.items
        self.flex = False     # absorbs the panel's leftover height
        #  Filled in at layout time.
        self.header = QRect()
        self.body = QRect()
        self.sep_y = None     # the etched rule below it, or None for the last


def read_spec(path):
    groups = []
    try:
        lines = open(path, encoding="utf-8").read().splitlines()
    except OSError:
        return groups
    for raw in lines:
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        head, _, rest = line.partition(" ")
        rest = rest.strip()
        if head == "group":
            groups.append(Group(rest))
        elif head == "bare":
            g = Group(None)
            g.bare = True
            g.widget = rest
            groups.append(g)
        elif head == "item" and groups:
            parts = [f.strip() for f in rest.split("|")]
            while len(parts) < 3:
                parts.append("")
            groups[-1].items.append(tuple(parts[:3]))
        elif head == "widget" and groups:
            groups[-1].widget = rest
        elif head == "flex" and groups:
            groups[-1].flex = True
    return groups


def read_state():
    try:
        with open(STATE, encoding="utf-8") as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return {}


def write_state(data):
    try:
        with open(STATE, "w", encoding="utf-8") as fh:
            json.dump(data, fh, indent=1, sort_keys=True)
            fh.write("\n")
    except OSError:
        pass


#  ---- Launcher rows ---------------------------------------------------

class LauncherBody(QWidget):
    """One group's launcher rows.

    A row is a `#cccccc` icon gutter 28px wide, then the label on `#d9d9d9`,
    on a 25px pitch with an etched divider along the bottom -- measured off
    the reference at y=22/40/45, where the gutter runs x=896..923.
    """

    def __init__(self, items, parent=None):
        super().__init__(parent)
        self.items = items
        self.font_row = photon.font(8)
        self._hover = -1
        self.setMouseTracking(True)

    def natural_height(self):
        return len(self.items) * photon.ROW_H

    def _row_rect(self, i):
        return QRect(0, i * photon.ROW_H, self.width(), photon.ROW_H)

    def _row_at(self, pos):
        if not self.rect().contains(pos):
            return -1
        i = pos.y() // photon.ROW_H
        return i if 0 <= i < len(self.items) else -1

    def paintEvent(self, event):
        p = QPainter(self)
        p.setFont(self.font_row)
        fm = QFontMetrics(self.font_row)
        for i, (label, icon, _cmd) in enumerate(self.items):
            r = self._row_rect(i)
            gutter = QRect(r.left(), r.top(), photon.GUTTER_W, r.height() - 2)
            face = QRect(r.left() + photon.GUTTER_W, r.top(),
                         r.width() - photon.GUTTER_W, r.height() - 2)
            hot = (i == self._hover)
            p.fillRect(gutter, photon.GUTTER)
            p.fillRect(face, photon.FACE_HI if hot else photon.FACE)

            box = QRect(gutter.left() + (photon.GUTTER_W - 16) // 2,
                        gutter.top() + (gutter.height() - 16) // 2, 16, 16)
            self._draw_icon(p, icon, box)

            p.setPen(photon.INK)
            baseline = face.top() + (face.height() + fm.capHeight()) // 2
            p.drawText(face.left() + 6, baseline,
                       photon.elide(label, self.font_row, face.width() - 10))
            photon.divider(p, r.bottom() - 1, r.left(), r.right())

    @staticmethod
    def _draw_icon(p, name, box):
        if not name:
            return
        #  A file in icons/ first, because that is where this config's own
        #  16x16 set lives.  Failing that, fall back to the icon theme on
        #  the bare name -- "16x16-firefox.png" becomes "firefox", which the
        #  Haiku set has even though icons/ does not.  A launcher with a
        #  hole where its icon should be is worse than a near miss.
        path = os.path.join(ICONS, name)
        if os.path.exists(path):
            pm = QPixmap(path)
            if not pm.isNull():
                if pm.width() != 16 or pm.height() != 16:
                    pm = pm.scaled(16, 16,
                                   Qt.AspectRatioMode.KeepAspectRatio,
                                   Qt.TransformationMode.SmoothTransformation)
                p.drawPixmap(box.left(), box.top(), pm)
                return
        stem = os.path.splitext(os.path.basename(name))[0]
        for candidate in (stem, stem.split("-", 1)[-1], stem.rsplit(".", 1)[-1]):
            if photon.draw_icon(p, candidate, box):
                return

    def mouseMoveEvent(self, event):
        i = self._row_at(event.position().toPoint())
        if i != self._hover:
            self._hover = i
            self.update()

    def leaveEvent(self, event):
        if self._hover != -1:
            self._hover = -1
            self.update()

    def mouseReleaseEvent(self, event):
        if event.button() != Qt.MouseButton.LeftButton:
            return
        i = self._row_at(event.position().toPoint())
        if i < 0:
            return
        command = self.items[i][2]
        if command:
            #  Through a shell, so the spec can use $VARS and pipelines, and
            #  detached so a launcher click cannot block the panel.
            subprocess.Popen(["/bin/sh", "-c", command],
                             start_new_session=True,
                             stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL)


#  ---- The panel -------------------------------------------------------

class Panel(QWidget):

    def __init__(self):
        super().__init__()
        self.setWindowTitle("ShelfPanel")
        pal = self.palette()
        pal.setColor(QPalette.ColorRole.Window, photon.FACE)
        self.setPalette(pal)
        self.setMouseTracking(True)

        self.font_header = photon.font(8, bold=True)
        self.state = read_state()
        self.groups = read_spec(SPEC)

        for g in self.groups:
            if not g.bare:
                g.collapsed = bool(self.state.get("collapsed", {}).get(g.label))
            if g.widget == "worldview":
                g.body_widget = WorldView(self)
            elif g.widget == "meters":
                g.body_widget = MetersWidget(self)
            elif g.widget == "media":
                g.body_widget = MediaWidget(self)
            elif g.widget == "tasks":
                g.body_widget = TasksWidget(self)
            elif g.widget == "tray":
                g.body_widget = TrayWidget(self)
            elif g.widget == "clock":
                g.body_widget = ClockWidget(self)
            elif g.items:
                g.body_widget = LauncherBody(g.items, self)
            else:
                g.body_widget = None
            #  hasattr rather than isinstance: the tray grows and shrinks
            #  with the icon count and has to trigger a relayout on its own,
            #  but nothing here should need to import TrayWidget just to
            #  check for it.
            if hasattr(g.body_widget, "natural_height_changed"):
                g.body_widget.natural_height_changed.connect(self.relayout)

        self._drag_from = None      # left-edge resize in progress
        self._drag_w = 0

        #  Coalesces the strut update: a drag fires dozens of resizes and
        #  each one would otherwise be an FvwmCommand spawn.
        self._strut = QTimer(self)
        self._strut.setSingleShot(True)
        self._strut.setInterval(60)
        self._strut.timeout.connect(self._push_strut)

        width = int(self.state.get("width", DEFAULT_W))
        self.resize(max(MIN_W, min(MAX_W, width)), 100)
        self.place()

    #  -- geometry --

    def screen_rect(self):
        scr = QApplication.primaryScreen()
        return scr.geometry() if scr else QRect(0, 0, 1920, 1080)

    def place(self):
        """Dock to the right edge, full screen height.

        FvwmTaskBar is gone, so there is no strip at the bottom to leave
        room for any more -- the panel now claims the whole edge, and
        Windows (the flex group) is what expands into the space a taskbar
        used to occupy.
        """
        s = self.screen_rect()
        self.setGeometry(s.right() + 1 - self.width(), s.top(),
                         self.width(), s.height())
        self.relayout()

    def _natural_height(self, widget, w):
        if isinstance(widget, WorldView):
            return widget.natural_height(w)
        if hasattr(widget, "natural_height"):
            return widget.natural_height()
        return widget.sizeHint().height()

    def _body_w(self, g, w):
        """The width a section's *body* gets.

        Bare sections -- the clock -- run the full width, as do widgets that
        declare `full_width` because their own background has to continue
        through the padding rather than giving way to shelf face.  Everything
        else keeps PAD_R clear on the right.
        """
        if g.bare or getattr(g.body_widget, "full_width", False):
            return w
        return w - PAD_R

    def _sep(self, g):
        return g is not self.groups[-1]

    def _group_height(self, g, w):
        """A group's total height at its natural size, without placing it --
        used to size the bottom-pinned block before laying it out."""
        h = 0 if g.bare else photon.HEADER_H
        if g.body_widget is not None and not g.collapsed:
            h += self._natural_height(g.body_widget, self._body_w(g, w))
        return h + (SEP_H if self._sep(g) else 0)

    def _place_group(self, g, x, y, w, height=None):
        """Position one group at `y` and return the y just past it.  `height`
        overrides the widget's own natural height, which is how the flex
        group is handed its share of the leftover space."""
        if g.bare:
            g.header = QRect(x, y, w, 0)
        else:
            g.header = QRect(x, y, w, photon.HEADER_H)
            y += photon.HEADER_H
        bw = self._body_w(g, w)
        widget = g.body_widget
        if widget is None or g.collapsed:
            g.body = QRect(x, y, bw, 0)
            if widget is not None:
                widget.hide()
        else:
            h = height if height is not None else self._natural_height(widget, bw)
            g.body = QRect(x, y, bw, h)
            widget.setGeometry(g.body)
            widget.show()
            y += h
        if self._sep(g):
            g.sep_y = y
            y += SEP_H
        else:
            g.sep_y = None
        return y

    def relayout(self):
        """Stack the sections.

        No group marked `flex` in panel.items: stack top to bottom as
        before, a collapsed group is its header alone, and the slack (if
        any) falls to the sunken filler at the bottom -- unchanged so a
        spec that never uses `flex` is unaffected.

        A `flex` group instead splits the stack in three: everything above
        it lays out from the top, everything below it is pinned to the
        bottom (sized first, at natural height, so we know where that block
        starts), and the flex group takes whatever vertical space is left
        between the two -- never less than its own natural height, so a
        panel too short to fit everything overflows rather than being
        crushed to nothing.
        """
        x = photon.FRAME_W
        w = self.width() - photon.FRAME_W
        flex = next((g for g in self.groups if g.flex), None)

        if flex is None:
            y = 0
            for g in self.groups:
                y = self._place_group(g, x, y, w)
            self.filler = QRect(x, y, w, max(0, self.height() - y))
            self.update()
            return

        i = self.groups.index(flex)
        top, bottom = self.groups[:i], self.groups[i + 1:]

        y = 0
        for g in top:
            y = self._place_group(g, x, y, w)
        top_y = y

        bottom_h = sum(self._group_height(g, w) for g in bottom)
        bottom_y = self.height() - bottom_h

        chrome = (0 if flex.bare else photon.HEADER_H) \
            + (SEP_H if self._sep(flex) else 0)
        flex_natural = (self._natural_height(flex.body_widget,
                                             self._body_w(flex, w))
                        if flex.body_widget is not None and not flex.collapsed
                        else 0)
        flex_h = max(flex_natural, bottom_y - top_y - chrome)
        self._place_group(flex, x, top_y, w, height=flex_h)

        y = bottom_y
        for g in bottom:
            y = self._place_group(g, x, y, w)

        #  Nothing left for a filler once a group is claiming the slack.
        self.filler = QRect(x, 0, w, 0)
        self.update()

    def resizeEvent(self, event):
        self.relayout()

    #  -- painting --

    def paintEvent(self, event):
        p = QPainter(self)
        p.fillRect(self.rect(), photon.FACE)
        photon.frame(p, self.rect())
        for g in self.groups:
            if not g.bare:
                photon.group_header(p, g.header, g.label, g.collapsed,
                                    self.font_header)
            if g.sep_y is not None:
                photon.divider(p, g.sep_y, photon.FRAME_W, self.width() - 1)
        if self.filler.height() > 0:
            photon.sunken(p, self.filler, photon.WELL)

    #  -- input --

    def _edge(self, pos):
        return pos.x() < photon.FRAME_W

    def _header_at(self, pos):
        for g in self.groups:
            if not g.bare and g.header.contains(pos):
                return g
        return None

    def mousePressEvent(self, event):
        if event.button() != Qt.MouseButton.LeftButton:
            return
        pos = event.position().toPoint()
        if self._edge(pos):
            self._drag_from = event.globalPosition().toPoint().x()
            self._drag_w = self.width()
            return
        g = self._header_at(pos)
        if g is not None and g.body_widget is not None:
            g.collapsed = not g.collapsed
            self.state.setdefault("collapsed", {})[g.label] = g.collapsed
            write_state(self.state)
            self.relayout()

    def mouseMoveEvent(self, event):
        pos = event.position().toPoint()
        if self._drag_from is None:
            self.setCursor(QCursor(Qt.CursorShape.SizeHorCursor
                                   if self._edge(pos)
                                   else Qt.CursorShape.ArrowCursor))
            return
        #  Docked right, so dragging the left edge leftward widens it.
        delta = self._drag_from - event.globalPosition().toPoint().x()
        width = max(MIN_W, min(MAX_W, self._drag_w + delta))
        if width != self.width():
            s = self.screen_rect()
            self.setGeometry(s.right() + 1 - width, s.top(),
                             width, s.height())
            self._strut.start()

    def mouseReleaseEvent(self, event):
        if self._drag_from is None:
            return
        self._drag_from = None
        self.state["width"] = self.width()
        write_state(self.state)
        self._push_strut()

    def _push_strut(self):
        """Tell fvwm how much edge the shelf is claiming.

        EwmhBaseStruts is a plain fvwm command and it does take effect at
        runtime: setting it to 400 and re-maximising a window took that
        window from 1750px to 1510px wide.  Without this, widening the shelf
        would just cover the windows underneath it.  Right only, now that
        FvwmTaskBar is gone -- there is no bottom strip left to claim.
        """
        QProcess.startDetached(
            "FvwmCommand", ["EwmhBaseStruts 0 %d 0 0" % self.width()])


def quit_on_sigterm(app):
    """Make SIGTERM an orderly exit, and return the socketpair keeping it alive.

    config restarts the panel by pkilling it, so SIGTERM is now how this
    process ordinarily ends.  Default-handled it dies without unwinding, and
    every child the components own -- stalonetray, `pactl subscribe` -- is
    orphaned rather than reaped, once per fvwm Restart.  Python defers a
    signal until the interpreter next runs bytecode, which inside Qt's C++
    event loop may be a long time; the wakeup fd turns the signal into
    something the loop itself can select on.
    """
    rsock, wsock = socket.socketpair()
    rsock.setblocking(False)
    wsock.setblocking(False)
    signal.set_wakeup_fd(wsock.fileno())
    signal.signal(signal.SIGTERM, lambda *_: None)

    notifier = QSocketNotifier(rsock.fileno(), QSocketNotifier.Type.Read, app)
    notifier.activated.connect(lambda *_: app.quit())
    return rsock, wsock


def main():
    if "--print-width" in sys.argv:
        #  For the config's EwmhBaseStruts line, which is read before this
        #  program is back up.  The strut has to be re-derived from the saved
        #  width or a widened shelf would reserve the default for as long as
        #  the restart takes.
        print(max(MIN_W, min(MAX_W, int(read_state().get("width", DEFAULT_W)))))
        return

    app = QApplication(sys.argv)
    app.setApplicationName("ShelfPanel")
    app.setDesktopFileName("ShelfPanel")
    _sigterm = quit_on_sigterm(app)
    panel = Panel()
    panel.setWindowTitle("ShelfPanel")
    panel.show()
    panel._push_strut()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
