#!/usr/bin/perl

# vim: syntax=perl:

##  Emit the cell list for the single-column QNX Photon "shelf".
##
##  The shelf is an accordion: each group has a header row that collapses or
##  expands the rows beneath it.  FvwmButtons cannot hide a button or resize
##  its grid at runtime -- ChangeButton reaches the title, icon and action of
##  an existing button and nothing else -- so a toggle is done by rewriting
##  the module config and starting a fresh module.  This script is both halves
##  of that: it flips one group's state (--toggle) and prints the config, plus
##  the Module/KillModule pair that puts it on screen.
##
##  That swap is double-buffered across two aliases, <alias>A and <alias>B.
##  Killing the live module and starting its replacement leaves the shelf
##  missing for about a frame -- measured at 12-17ms, brief but visible as a
##  blink.  Mapping the replacement first and killing the old one 150ms later
##  never drops below one mapped shelf, measured at under 1ms of exposure,
##  which is under a frame and so never reaches the screen.  The cost is that
##  the shelf's window name alternates, so styles must match "<alias>?".
##
##  Which groups are collapsed, and which alias is live, live in --state, not
##  in the spec, so the spec stays a file you edit by hand and the state is
##  throwaway runtime data.
##
##  Cells are 1px-wide grid columns stacked into one column, mirroring
##  mk-taskbar's 1px-tall rows, so a cell's grid height is its pixel height.
##  Geometry/Rows/Columns are emitted here for the same reason they are there:
##  $[vp.height] expands in a command but not in a "*Module: option" line.
##
##  There are two shelf windows, and this generates both.  ShelfMenu is the
##  accordion; it swaps aliases on every toggle and must therefore contain no
##  swallowed windows, because the outgoing instance still holds a swallowed
##  window reparented inside it when the incoming one looks for it, and
##  Swallow's UseOld then spawns a duplicate that is left stranded on the
##  desktop.  ShelfDock holds everything swallowed -- pager, meters, media --
##  and is --static: it never swaps, so its swallows are stable.
##
##  The kill-and-regenerate above is correct as designed, but it is not the
##  only design.  FvwmButtons' Panel primitive swallows a window and hides it
##  rather than destroying it, sliding it into view on a press
##  (FvwmButtons.html, "CREATING PANELS"), so a panel-based accordion never
##  destroys anything and the stranding problem does not exist for it.  The
##  catch is that a panel slides over its parent rather than repacking the
##  rows below it, so it is a different shelf, not a cheaper one -- but it
##  was never tried, and the next reader should know that before treating
##  the regeneration as forced.
##
##  usage: mk-shelf --spec F --alias A --width N --height N|auto [--state F]
##                  [--position +0+0] [--toggle GROUP] [--header-height N]
##                  [--swap-delay MS] [--define KEY=VALUE]... [--static]
##                  [--height-var NAME]
##
##  --define substitutes %KEY% anywhere in the spec.  It exists because some
##  row heights are only knowable at runtime -- the pager's height follows the
##  monitor's aspect ratio -- and the spec is a static file.
##
##  --toggle with an empty argument is a plain re-render, so the caller can
##  pass an fvwm function argument through unconditionally.
##
##  --static drops the alias alternation and the state file, and draws group
##  headers without a toggle binding.  Nothing in a static shelf collapses.
##
##  --height auto sizes the window to the rows it holds rather than the other
##  way round, and needs --height-var to publish the result as an InfoStore
##  key so the caller can subtract it.  A flex row has nothing to expand into
##  under auto, so the two are mutually exclusive.

use strict ;
use warnings ;
use v5.40.1 ;

use Getopt::Long ;

my ( $spec, $alias, $width, $height, $state_file, $height_var ) ;
my $static = 0 ;
my $position = '-0+0' ;
my $hdr_height = 20 ;
my $swap_delay = 150 ;
my $toggle ;
my %define ;

GetOptions(
    'spec=s'          => \$spec,
    'alias=s'         => \$alias,
    'width=i'         => \$width,
    'height=s'        => \$height,
    'height-var=s'    => \$height_var,
    'static'          => \$static,
    'state=s'         => \$state_file,
    'position=s'      => \$position,
    'header-height=i' => \$hdr_height,
    'swap-delay=i'    => \$swap_delay,
    'define=s'        => \%define,
    'toggle=s'        => \$toggle,
) or die "$0: bad options\n" ;

die "usage: $0 --spec F --alias A --width N --height N|auto [--state F]\n"
    unless $spec and $alias and defined $height
    and $width and $width > 0 ;
die "$0: --height must be a positive number or 'auto'\n"
    unless $height eq 'auto' or ( $height =~ /^[0-9]+$/ and $height > 0 ) ;
die "$0: --height auto needs --height-var\n"
    if $height eq 'auto' and not $height_var ;
die "$0: --state is required unless --static\n"
    unless $static or $state_file ;

##  State: one group name per line means collapsed, plus a "!live <alias>"
##  line naming the alias currently on screen.  A group absent from the file
##  is expanded, so a missing state file is a fully expanded shelf.
my %collapsed ;
my $live = '' ;
if ( !$static and open my $fh, '<', $state_file ) {
    while ( <$fh> ) {
        chomp ;
        s/^\s+|\s+$//g ;
        next unless length ;
        if ( my ( $a ) = /^!live\s+(\S+)$/ ) { $live = $a ; next }
        $collapsed{$_} = 1 ;
    }
    close $fh ;
}

open my $fh, '<', $spec or die "$0: $spec: $!\n" ;
my $text = do { local $/ ; <$fh> } ;
close $fh ;

##  Fold continuation lines first, so a wrapped cell stays one cell.
$text =~ s/\s*\\\n\s*/ /g ;

##  Parse into groups.  Rows before the first "group" line belong to a
##  headerless pseudo-group that is always shown, which is how a fixed item
##  (a clock, a tray) sits in the shelf without a twisty above it.
my @groups = ( { name => undef, rows => [] } ) ;
my @preamble ;
for my $line ( split /\n/, $text ) {
    ##  Only a leading '#' is a comment: '#rrggbb' is legal inside options.
    next if $line =~ /^\s*(?:#|$)/ ;

    ##  Substitute --define values.  This runs after the comment check so that
    ##  the spec can document its own %KEY% syntax without triggering it.  An
    ##  undefined %KEY% is a typo, not something to paper over with an empty
    ##  string.
    $line =~ s{%(\w+)%}{
        exists $define{$1} ? $define{$1} : die "$0: $spec: undefined %$1%\n"
    }ge ;

    ##  A '*' line is a module-wide option, emitted verbatim.  It has to come
    ##  from the spec rather than the config, because the DestroyModuleConfig
    ##  below would wipe anything the config had already set.
    if ( my ( $opt ) = $line =~ /^\s*\*\s*(.*?)\s*$/ ) {
        push @preamble, $opt ;
        next ;
    }

    ##  "endgroup" returns to the headerless always-shown context, so a row
    ##  that must survive every collapse -- the filler, a clock -- can sit
    ##  between two groups instead of being swallowed by the one above it.
    if ( $line =~ /^\s*endgroup\s*$/ ) {
        push @groups, { name => undef, rows => [] } ;
        next ;
    }

    if ( my ( $name, $opts ) = $line =~ /^\s*group\s+(\S+)\s*(.*?)\s*$/ ) {
        push @groups, { name => $name, label => $opts || $name, rows => [] } ;
        next ;
    }

    my ( $size, $opts ) = $line =~ /^\s*(\S+)\s*(.*?)\s*$/ ;
    if ( $size =~ /^[0-9]+$/ ) {
        push @{ $groups[-1]{rows} }, { px => 0 + $size, opts => $opts } ;
    }
    elsif ( $size =~ /^flex(?::([0-9]+))?$/ ) {
        push @{ $groups[-1]{rows} }, { weight => $1 // 1, opts => $opts } ;
    }
    else {
        die "$0: $spec: bad height '$size'\n" ;
    }
}

my %known = map { $_->{name} => 1 } grep { defined $_->{name} } @groups ;

##  A static shelf has one alias and no state: nothing in it collapses, so
##  there is nothing to record and no reason to alternate.
my ( $new, $old ) ;
if ( $static ) {
    die "$0: --toggle makes no sense with --static\n"
        if defined $toggle and length $toggle ;
    $new = $alias ;
}
else {
    ##  --toggle flips one group before the config is generated, so the
    ##  emitted config already reflects the click.
    if ( defined $toggle and length $toggle ) {
        die "$0: no such group '$toggle' in $spec\n" unless $known{$toggle} ;
        $collapsed{$toggle} ? delete $collapsed{$toggle} : ( $collapsed{$toggle} = 1 ) ;
    }

    ##  Drop state for groups that have since left the spec, so the file does
    ##  not accumulate names that no longer mean anything.
    delete $collapsed{$_} for grep { !$known{$_} } keys %collapsed ;

    ##  Pick the idle alias to render into.  An unrecognised (or absent)
    ##  recorded alias means a first run or a state file from an older
    ##  version, and "B" is as good a starting point as any.
    my ( $alias_a, $alias_b ) = ( "${alias}A", "${alias}B" ) ;
    $new = $live eq $alias_b ? $alias_a : $alias_b ;
    $old = $new eq $alias_b ? $alias_a : $alias_b ;

    ##  Write via a temp file and rename, so a shelf toggled twice in quick
    ##  succession never reads a half-written state file.
    my $tmp = "$state_file.$$" ;
    open my $out, '>', $tmp or die "$0: $tmp: $!\n" ;
    print $out "!live $new\n" ;
    print $out "$_\n" for sort keys %collapsed ;
    close $out or die "$0: $tmp: $!\n" ;
    rename $tmp, $state_file or die "$0: $state_file: $!\n" ;
}

##  Flatten groups into cells, skipping the rows of collapsed groups.
my @cells ;
for my $group ( @groups ) {
    if ( defined $group->{name} ) {
        my $shut = $collapsed{ $group->{name} } ;
        ##  A static shelf's header keeps the "-" glyph and the group's look,
        ##  but carries no binding: it is a section label, not a control.
        my $hdr = sprintf
            'Title(Left) "%s %s", Frame 0, Font $[infostore.shelf_header_font], '
          . 'Colorset $[infostore.cs_shelf_header], '
          . 'ActiveColorset $[infostore.cs_shelf_header]',
            ( $shut ? '+' : '-' ), $group->{label} ;
        $hdr .= sprintf ', Action(Mouse 1) Function ShelfToggle %s', $group->{name}
            unless $static ;
        push @cells, { px => $hdr_height, opts => $hdr } ;
        next if $shut ;
    }
    push @cells, @{ $group->{rows} } ;
}

my @flex = grep { $_->{weight} } @cells ;
my $fixed = 0 ;
$fixed += $_->{px} for grep { !$_->{weight} } @cells ;

##  "auto" turns the sizing round: the window becomes exactly as tall as its
##  rows.  Publishing it as an InfoStore key is what lets the caller render
##  the dock first and then subtract its height when sizing the menu above it.
if ( $height eq 'auto' ) {
    die "$0: $spec: --height auto cannot be used with a flex row\n" if @flex ;
    $height = $fixed ;
}

if ( @flex ) {
    my $avail = $height - $fixed ;
    ##  If the fixed rows already overflow there is no honest answer, so give
    ##  each flex row a pixel and complain.  PipeRead only reads stdout, so a
    ##  warning cannot corrupt the emitted config.
    if ( $avail < @flex ) {
        warn "$0: fixed rows need ${fixed}px of ${height}px, flex rows squeezed\n" ;
        $avail = scalar @flex ;
    }
    my $wsum = 0 ;
    $wsum += $_->{weight} for @flex ;
    ##  Split on the running weight total rather than per row, so rounding is
    ##  spread across the flex rows instead of accumulating, and the heights
    ##  add up to exactly $avail.
    my ( $wacc, $pacc ) = ( 0, 0 ) ;
    for my $cell ( @flex ) {
        $wacc += $cell->{weight} ;
        my $upto = int( $avail * $wacc / $wsum ) ;
        $cell->{px} = $upto - $pacc ;
        $pacc = $upto ;
    }
}
elsif ( $fixed != $height ) {
    warn "$0: rows total ${fixed}px, shelf is ${height}px, and no flex row\n" ;
}

##  Self-contained, because this is PipeRead both at startup and on every
##  toggle: without the Destroy the second read would append to the first.
printf "InfoStoreAdd %s %d\n", $height_var, $height if $height_var ;
printf "DestroyModuleConfig %s:*\n", $new ;
printf "*%s: Geometry %dx%d%s\n", $new, $width, $height, $position ;
printf "*%s: Columns 1\n",        $new ;
printf "*%s: Rows %d\n",          $new, $height ;
printf "*%s: %s\n", $new, $_ for @preamble ;

##  Contents taller than their row are clipped rather than growing the grid,
##  because the emitted Geometry pins the window size.
printf "*%s: (1x%d%s)\n", $new, $_->{px},
    length $_->{opts} ? ", $_->{opts}" : ''
    for @cells ;

if ( $static ) {
    ##  Kill first, then start: the opposite order to the accordion's, and
    ##  deliberately so.  This is the window that holds the swallowed pager
    ##  and meters, and Swallow's UseOld can only find them once the previous
    ##  instance is gone.  Overlapping the two here is what stranded a second
    ##  pager on the desktop.  The cost is a frame of flicker on a re-render,
    ##  which only happens on Restart, not on a click.
    printf "KillModule FvwmButtons %s\n", $new ;
    printf "Schedule %d Module FvwmButtons %s\n", $swap_delay, $new ;
}
else {
    ##  Map the replacement, then retire the old one.  The KillModule is
    ##  emitted unconditionally: on a first run the old alias is not running
    ##  and killing it is a no-op, and after a crash that left a stray shelf
    ##  behind it is the thing that cleans it up.
    printf "Module FvwmButtons %s\n", $new ;
    printf "Schedule %d KillModule FvwmButtons %s\n", $swap_delay, $old ;
}
