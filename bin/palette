#!/usr/bin/env python3
"""Render palette/ templates with wallust, then preview the diff or apply it.

  palette preview photon            a scheme from palette/schemes/
  palette preview ~/wall.png -- -k   an image; args after -- go to wallust
  palette apply photon
  palette save my-favorite          the live palette, as palette/schemes/my-favorite.json
  palette save my-favorite --from ~/wall.png -- -t 20   a variant, without applying it
  palette list
  palette sweep a.png b.png tang-cats                 the shelf in each, side by side
  palette sweep wall.png --vary backend=full,resized --vary contrast=off,on
  palette sweep wall.png --axis palette --vs live  every value of one axis, and the live palette
  palette sweep --interactive [same options]          a local page: drop images, pick axes, save

preview and apply render into ~/.cache/palette/preview; wallust never writes a live file.
sweep renders each variant into ~/.cache/palette/sweep/v/, draws the shelf with
bin/shelf-snapshot, and writes ~/.cache/palette/sweep/index.html.
`apply` backs up what it replaces in ~/.fvwm/palette/history beside a
restore.sh and a pre-apply screen.png so you can tell backups apart.
Both also write ~/.cache/palette/key.html: each color, the role it comes
from, and every place it lands.
"""

import argparse
import datetime
import functools
import difflib
import hashlib
import html
import itertools
import json
import os
import re
import secrets
import shlex
import shutil
import signal
import subprocess
import sys
import tempfile
import threading
import time
import tomllib
from concurrent.futures import ThreadPoolExecutor
from dataclasses import dataclass
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from urllib.parse import unquote

BIN = Path(__file__).resolve().parent
ROOT = BIN.parent / "palette"
CACHE = Path.home() / ".cache" / "palette"
PREVIEW = CACHE / "preview"
HEX = re.compile(r"#[0-9A-Fa-f]{6,8}\b")


def templates():
    conf = tomllib.loads((ROOT / "wallust.toml").read_text())["templates"]
    return {name: (t["template"], Path(os.path.expanduser(t["target"])))
            for name, t in conf.items()}


def source_cmd(source):
    scheme = ROOT / "schemes" / f"{source}.json"
    if scheme.is_file():
        return ["wallust", "cs", "-f", "pywal", str(scheme)]
    path = Path(source).expanduser().resolve()
    if not path.is_file():
        sys.exit(f"palette: no scheme or image named {source!r}")
    if path.suffix == ".json":
        return ["wallust", "cs", "-f", "pywal", str(path)]
    return ["wallust", "run", str(path)]


def wallust(source, extra, tpl_dir, targets):
    with tempfile.TemporaryDirectory(prefix="palette-") as work:
        work = Path(work)
        (work / "templates").symlink_to(tpl_dir)
        lines = ["[templates]"] + [
            f'{name} = {{ template = "{tpl}", target = "{out}" }}'
            for name, (tpl, out) in targets.items()
        ]
        (work / "wallust.toml").write_text("\n".join(lines) + "\n")
        cmd = source_cmd(source) + ["-s", "--no-hooks", "-q", "-d", str(work)] + extra
        done = subprocess.run(cmd, stderr=subprocess.PIPE, text=True)
        if done.returncode:
            sys.stderr.write(done.stderr)
            raise subprocess.CalledProcessError(done.returncode, cmd, stderr=done.stderr)


def render(source, extra):
    shutil.rmtree(PREVIEW, ignore_errors=True)
    PREVIEW.mkdir(parents=True)
    wallust(source, extra, ROOT / "templates",
            {name: (tpl, PREVIEW / name) for name, (tpl, _) in templates().items()})
    for path in PREVIEW.iterdir():
        path.write_text(HEX.sub(lambda m: m[0].lower(), path.read_text()))
    write_key(source, extra)
    print(f"Key: {KEY}")


# The key renders an instrumented copy of every template: each {{ }} is
# wrapped in markers, so each color is found where it actually landed.
KEY = CACHE / "key.html"
MARK = re.compile(r"\x02(\d+)\x03|\x04")
TAG = re.compile(r"\{\{-?\s*(.*?)\s*-?\}\}(?:\{#\s*(.*?)\s*#\})?", re.S)
SCHEME = ["background", "foreground", "cursor"] + [f"color{i}" for i in range(16)]


def parse_color(value):
    value = value.strip().lower()
    if m := re.fullmatch(r"#?(?:ff)?([0-9a-f]{6})", value):
        return "#" + m[1]
    if m := re.fullmatch(r"(\d+),\s*(\d+),\s*(\d+)", value):
        return "#" + "".join(f"{int(c):02x}" for c in m.groups())
    return None


def instrument(text, sites):
    def mark(m):
        line_start = text.rfind("\n", 0, m.start()) + 1
        seg_start = max(line_start, text.rfind("}", line_start, m.start()) + 1)
        label = m[2] or text[seg_start:m.start()].strip(" \t\"',;:=({")
        sites.append({"expr": m[1], "label": label})
        return f"\x02{len(sites) - 1}\x03{m[0]}\x04"
    return TAG.sub(mark, text)


def section(lines, row):
    """Nearest header (comment, [group] or `selector {`) in the row's paragraph."""
    for line in reversed(lines[:row]):
        s = line.strip()
        if not s:
            return ""
        if m := re.fullmatch(r"(?:#+|!|//|/\*)[\s~=*-]*(.*?)[\s*/]*", s):
            return m[1]
        if m := re.fullmatch(r"\[(.+)\]|([^{}]+?)\s*\{", s):
            return m[1] or m[2]
    return ""


def harvest(target, text, sites, uses):
    """Record each color-valued marker not nested inside another one."""
    plain = MARK.sub("", text)
    lines = plain.splitlines()
    stack, spans, offset = [], [], 0
    for m in MARK.finditer(text):
        if m[1]:
            offset += len(m[0])
            stack.append((int(m[1]), m.end() - offset))
            continue
        site, start = stack.pop()
        end = m.start() - offset
        offset += len(m[0])
        if color := parse_color(plain[start:end]):
            spans.append((start, end, site, color))
    for start, end, site, color in spans:
        if any(s <= start and end <= e and (s, e) != (start, end)
               for s, e, _, _ in spans):
            continue
        row = plain.count("\n", 0, start)
        uses.append({"target": target, "site": site, "color": color,
                     "line": lines[row].strip(), "section": section(lines, row)})


def write_key(source, extra):
    formulas = dict(re.findall(r"\{%-?\s*set (\w+) = (.+?)\s*-?%\}",
                               (ROOT / "templates" / "roles.j2").read_text()))
    sites, uses = [], []
    with tempfile.TemporaryDirectory(prefix="palette-key-") as tmp:
        tmp = Path(tmp)
        tpl = tmp / "templates"
        tpl.mkdir()
        for src in (ROOT / "templates").iterdir():
            (tpl / src.name).write_text(instrument(src.read_text(), sites))
        (tpl / "_roles").write_text(instrument('{% include "roles.j2" %}\n' + "".join(
            f"{{{{ {n} }}}}{{# {n} #}}\n" for n in SCHEME + list(formulas)), sites))
        targets = {name: (t, tmp / name) for name, (t, _) in templates().items()}
        targets["_roles"] = ("_roles", tmp / "_roles")
        wallust(source, extra, tpl, targets)
        for name, (_, out) in targets.items():
            harvest(name, out.read_text(), sites, uses)

    role = {sites[u["site"]]["label"]: u["color"] for u in uses if u["target"] == "_roles"}
    rows, used_in = {}, {}
    for u in uses:
        if u["target"] == "_roles":
            continue
        site = sites[u["site"]]
        row = rows.setdefault(u["target"], {}).setdefault(
            (u["site"], u["color"], u["section"]), {**u, **site, "lines": []})
        line = HEX.sub(lambda m: m[0].lower(), u["line"])
        if len(line) > 90 and (m := re.match(r"\s*([^\s=:]+)\s*[=:]", line)):
            line = m[1]
        if line not in row["lines"]:
            row["lines"].append(line)
        row["roles"] = [w for w in re.findall(r"\w+", site["expr"]) if w in role] or [
            n for n, c in role.items() if c == u["color"] and n in formulas]
        for n in row["roles"]:
            used_in.setdefault(n, set()).add(u["target"])
    KEY.write_text(key_html(source, role, formulas, rows, used_in))


def key_html(source, role, formulas, rows, used_in):
    esc = html.escape

    def chip(color):
        r, g, b = (int(color[i:i + 2], 16) for i in (1, 3, 5))
        ink = "#000" if 0.299 * r + 0.587 * g + 0.114 * b > 140 else "#fff"
        return f'<span class="chip" style="background:{color};color:{ink}">{color}</span>'

    def targets(names):
        return " ".join(f'<a href="#{t}">{t}</a>' for t in sorted(names))

    out = [KEY_HEAD, f"<h1>Palette key</h1><p class=meta>{esc(str(source))} · "
           f"{datetime.datetime.now():%Y-%m-%d %H:%M} · "
           f"{' '.join(f'<a href=#{t}>{t}</a>' for t in rows)}</p>",
           "<h2>Scheme</h2><div class=grid>"]
    out += [f"<div>{chip(role[n])}<b>{n}</b></div>" for n in SCHEME if n in role]
    out.append("</div><h2>Roles <small>palette/templates/roles.j2</small></h2><table>")
    out += [f"<tr><td>{chip(role[n])}</td><td><b>{n}</b></td><td><code>{esc(f)}</code></td>"
            f"<td>{targets(used_in.get(n, ()))}</td></tr>"
            for n, f in formulas.items() if n in role]
    out.append("</table>")
    for target, live in ((t, p) for t, (_, p) in templates().items() if t in rows):
        out.append(f'<h2 id="{target}">{target} <small>{esc(str(live))}</small></h2><table>')
        for r in rows[target].values():
            where = esc(r["label"]) + (f' <small>{esc(r["section"])}</small>' if r["section"] else "")
            line = "<br>".join(esc(x[:90]) for x in r["lines"])
            out.append(f"<tr><td>{chip(r['color'])}</td><td>{where}</td>"
                       f"<td><code>{esc(r['expr'])}</code></td>"
                       f"<td>{'' if r['roles'] == [r['expr']] else ' '.join(r['roles'])}</td>"
                       f"<td class=line><code>{line}</code></td></tr>")
        out.append("</table>")
    return "\n".join(out) + "\n"


KEY_HEAD = """<!doctype html><meta charset=utf-8><title>Palette key</title>
<style>
:root { --bg: #f5f3f0; --fg: #1c1a18; --dim: #6b655f; --rule: #d9d4ce; }
@media (prefers-color-scheme: dark) {
  :root { --bg: #1c1a18; --fg: #e8e4df; --dim: #9a938b; --rule: #38342f; } }
body { background: var(--bg); color: var(--fg); font: 14px/1.4 sans-serif;
       margin: 24px auto; max-width: 1200px; padding: 0 16px; }
h2 { border-bottom: 1px solid var(--rule); padding-bottom: 4px; margin-top: 32px; }
small, .meta { color: var(--dim); font-weight: normal; }
a { color: inherit; }
table { border-collapse: collapse; width: 100%; }
td { padding: 3px 10px 3px 0; border-bottom: 1px solid var(--rule); vertical-align: middle; }
code { font-size: 12px; }
.line code { color: var(--dim); }
.chip { display: inline-block; width: 76px; padding: 6px 0; text-align: center;
        font: 12px monospace; border: 1px solid #0005; }
.grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(110px, 1fr)); gap: 8px; }
.grid b { display: block; font-size: 12px; }
</style>"""


def changes():
    for name, (_, live) in templates().items():
        new = (PREVIEW / name).read_text()
        old = live.read_text() if live.exists() else None
        if new != old:
            yield name, live, old, new


def preview(args):
    render(args.source, args.wallust)
    changed = list(changes())
    for name, live, old, new in changed:
        if old is None:
            print(f"=== {name}: new file {live}")
            continue
        sys.stdout.writelines(difflib.unified_diff(
            old.splitlines(True), new.splitlines(True),
            f"{live}", f"{PREVIEW / name}"))
    same = len(templates()) - len(changed)
    print(f"\n{len(changed)} would change, {same} unchanged. "
          f"Rendered files: {PREVIEW}")


def set_ini_key(path, key, value):
    text = path.read_text()
    line = f"{key}={value}"
    if re.search(rf"^{key}=", text, re.M):
        text = re.sub(rf"^{key}=.*$", line, text, flags=re.M)
    else:
        text = text.replace("[Appearance]\n", f"[Appearance]\n{line}\n", 1)
    path.write_text(text)


def kde_merge(colors):
    group = None
    for line in colors.read_text().splitlines():
        if line.startswith("[Colors:"):
            group = line[1:-1]
        elif line.startswith("["):
            group = None
        elif group and "=" in line:
            key, value = line.split("=", 1)
            subprocess.run(["kwriteconfig6", "--file", "kdeglobals",
                            "--group", group, "--key", key, value], check=True)


def apply(args):
    render(args.source, args.wallust)
    changed = {name: live for name, live, _, _ in changes()}
    if not changed:
        print("nothing to apply")
        return

    ct = {v: Path.home() / f".config/{v}/{v}.conf" for v in ("qt5ct", "qt6ct")}
    extra = [ct[n] for n in ct if n in changed]
    if "kde" in changed:
        extra.append(Path.home() / ".config/kdeglobals")

    backup = ROOT / "history" / datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
    backup.mkdir(parents=True)
    shot = backup / "screen.png"
    if subprocess.run(["import", "-window", "root", str(shot)]).returncode:
        print(f"palette: could not capture {shot}")
    restore = ["#!/bin/sh", "set -e"]
    for i, live in enumerate(list(changed.values()) + extra):
        if live.exists():
            saved = backup / f"{i}-{live.name}"
            shutil.copyfile(live, saved)
            restore.append(f"cp {shlex.quote(str(saved))} {shlex.quote(str(live))}")
        else:
            restore.append(f"rm -f {shlex.quote(str(live))}")
    (backup / "restore.sh").write_text("\n".join(restore) + "\n")
    (backup / "restore.sh").chmod(0o755)

    for name, live in changed.items():
        live.parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(PREVIEW / name, live)
        print(f"wrote {live}")

    for name in ct:
        if name in changed:
            set_ini_key(ct[name], "color_scheme_path", changed[name])
            set_ini_key(ct[name], "custom_palette", "true")
    if "kde" in changed:
        kde_merge(changed["kde"])
    if "xresources" in changed:
        subprocess.run(["xrdb", "-merge", str(changed["xresources"])])
    if "kitty" in changed:
        subprocess.run(["pkill", "-USR1", "-x", "kitty"])
    if "fvwm" in changed:
        subprocess.run(["FvwmCommand", "Restart"])

    print(f"\nBackup and undo script: {backup}/restore.sh")
    print("Qt and GTK apps pick the new colors up when they next start.")


XRES = re.compile(r"^\*\.(\w+):\s*(#[0-9A-Fa-f]{6})\s*$", re.M)


def render_into(source, flags, out, names):
    """Render the templates `names` for one variant into out/, each file named
    after its template.  LIVE copies what apply last wrote instead."""
    targets = {n: (tpl, out / tpl) for n, (tpl, _) in templates().items() if n in names}
    if source == LIVE:
        for name, (_, dest) in targets.items():
            live = templates()[name][1]
            if live.is_file():
                shutil.copyfile(live, dest)
        return
    extra = list(flags)
    #  Parallel sweep renders would race on ~/.cache/wallust.
    if is_image(source) and "-n" not in extra:
        extra.append("-n")
    wallust(source, extra, ROOT / "templates", targets)


def save_variant(name, source, flags=(), force=False):
    """Write a scheme from the Xresources a variant renders: it holds the
    resolved colors as they are, whether they came from a scheme or an image."""
    if not re.fullmatch(r"[\w-]+", name):
        sys.exit(f"palette: {name!r} is not a usable scheme name")
    scheme = ROOT / "schemes" / f"{name}.json"
    if scheme.exists() and not force:
        sys.exit(f"palette: {scheme.name} exists; --force replaces it")
    with tempfile.TemporaryDirectory(prefix="palette-save-") as tmp:
        xres = Path(tmp) / templates()["xresources"][0]
        render_into(source, flags, Path(tmp), {"xresources"})
        if not xres.is_file():
            sys.exit("palette: nothing has been applied yet")
        got = {k: v.lower() for k, v in XRES.findall(xres.read_text())}
    scheme.write_text(json.dumps({
        "special": {"background": got["background"],
                    "foreground": got["foreground"],
                    "cursor": got["cursorColor"]},
        "colors": {f"color{i}": got[f"color{i}"] for i in range(16)},
    }, indent=2) + "\n")
    return scheme


def save(args):
    if args.wallust and not args.source:
        sys.exit("palette: wallust args need --from")
    scheme = save_variant(args.name, args.source or LIVE, tuple(args.wallust), args.force)
    print(f"saved {scheme}")


def list_schemes(args):
    for path in sorted((ROOT / "schemes").glob("*.json")):
        print(path.stem)


#  ---- sweep -----------------------------------------------------------------

SWEEP = CACHE / "sweep"
UPLOADS = SWEEP / "uploads"
PAGE = BIN / "palette-sweep.html"
LIVE = ":live"
MAX_VARIANTS = 64
IMAGE_EXTS = {".png", ".jpg", ".jpeg", ".webp", ".gif", ".bmp"}


#  (axis, flag, values): None reads the values from `wallust run -h`, () is an
#  off/on switch.  Axes whose flag the installed wallust lacks are dropped, so
#  3.5 gets colorspace and fallback, 4.x gets style and use16cols.
AXIS_SPECS = (
    ("palette", "-p", None),
    ("style", "-S", None),
    ("backend", "-b", None),
    ("colorspace", "-c", None),
    ("fallback", "-f", None),
    ("threshold", "-t", ("5", "10", "15", "20", "30")),
    ("saturation", "--saturation", ("20", "40", "60", "80")),
    ("contrast", "-k", ()),
    ("use16cols", "--use16cols", ()),
)


@functools.cache
def axes():
    """Axis -> value -> the wallust flags it adds."""
    try:
        text = subprocess.run(["wallust", "run", "-h"], capture_output=True, text=True).stdout
    except OSError:
        text = ""
    opts = {}
    for entry in re.split(r"\n(?= {2,6}-)", text):
        m = re.match(r"\s*(?:(-\w), )?(--[\w-]+)", entry)
        if m:
            found = re.search(r"\[possible values: ([^\]]+)\]", " ".join(entry.split()))
            for flag in filter(None, m.groups()):
                opts[flag] = found[1].split(", ") if found else None
    out = {}
    for axis, flag, values in AXIS_SPECS:
        if flag not in opts:
            continue
        if values == ():
            out[axis] = {"off": (), "on": (flag,)}
        elif values or opts[flag]:
            out[axis] = {v: (flag, v) for v in values or opts[flag]}
    return out


def is_image(source):
    return source != LIVE and source_cmd(source)[1] == "run"


def normal_source(source):
    """Schemes by name, images by absolute path, so a variant's identity is stable."""
    if source == LIVE or (ROOT / "schemes" / f"{source}.json").is_file():
        return source
    source = str(Path(source).expanduser().resolve())
    source_cmd(source)
    return source


def source_label(source):
    if source == LIVE:
        return "live"
    if (ROOT / "schemes" / f"{source}.json").is_file():
        return source
    path = Path(source)
    name = path.with_name(path.name + ".name")
    return name.read_text().strip() if path.parent == UPLOADS and name.is_file() else path.name


def source_info(source):
    return {"source": source, "label": source_label(source),
            "kind": "image" if is_image(source) else "scheme"}


@dataclass(frozen=True)
class Variant:
    source: str
    flags: tuple = ()

    @property
    def key(self):
        return hashlib.sha1(json.dumps([self.source, self.flags]).encode()).hexdigest()[:16]

    @property
    def dir(self):
        return SWEEP / "v" / self.key


def check_vary(vary):
    for axis, values in vary.items():
        if axis not in axes():
            sys.exit(f"palette: no axis {axis!r}; one of {', '.join(axes())}")
        for value in values:
            if value not in axes()[axis]:
                sys.exit(f"palette: {axis} has no value {value!r}; "
                         f"one of {', '.join(axes()[axis])}")
    return {axis: list(dict.fromkeys(values)) for axis, values in vary.items() if values}


def parse_vary(specs, axes):
    vary = {axis: list(axes().get(axis, ())) for axis in axes}
    for spec in specs:
        axis, _, values = spec.partition("=")
        vary.setdefault(axis, []).extend(values.split(","))
    return check_vary(vary)


def plan(sources, vary, vs_live):
    """The flag-set columns, and every variant: one per image and flag set,
    one per scheme (wallust cs takes no generation flags), one for live."""
    columns = [tuple(f for axis, value in zip(vary, combo) for f in axes()[axis][value])
               for combo in itertools.product(*vary.values())]
    sources = list(dict.fromkeys(normal_source(s) for s in sources))
    variants = [Variant(s, flags) for s in sources
                for flags in (columns if is_image(s) else [()])]
    if vs_live:
        variants.append(Variant(LIVE))
    if not variants:
        sys.exit("palette: nothing to sweep; name an image or scheme, or --vs live")
    if len(variants) > MAX_VARIANTS:
        images = sum(map(is_image, sources))
        sys.exit(f"palette: {len(variants)} variants ({images} image(s) x {len(columns)} "
                 f"flag sets, plus schemes) is over the limit of {MAX_VARIANTS}; "
                 "drop a --vary value or a source")
    return columns, variants


def render_variant(v):
    shutil.rmtree(v.dir, ignore_errors=True)
    v.dir.mkdir(parents=True)
    (v.dir / "meta.json").write_text(json.dumps({"source": v.source, "flags": v.flags}))
    for name in ("panel.items", "icons"):
        (v.dir / name).symlink_to(BIN.parent / name)
    #  A copy, so the preview matches the live width, side and collapsed groups.
    if (BIN.parent / ".panel.state").is_file():
        shutil.copyfile(BIN.parent / ".panel.state", v.dir / ".panel.state")
    try:
        render_into(v.source, v.flags, v.dir, {"fvwm", "xresources"})
    except subprocess.CalledProcessError as e:
        return e.stderr.strip() or f"wallust exited {e.returncode}"
    if not (v.dir / "colorsets").is_file():
        return "no colorsets rendered"
    return None


def snapshot(v):
    done = subprocess.run(
        [sys.executable, str(BIN / "shelf-snapshot"), "--out", str(v.dir / "panel.png")],
        env={**os.environ, "FVWM_USERDIR": str(v.dir)}, capture_output=True, text=True)
    if done.returncode:
        return (done.stderr.strip().splitlines() or ["shelf-snapshot failed"])[-1]
    return None


def variant_from_key(key):
    if not re.fullmatch(r"[0-9a-f]{16}", key or ""):
        sys.exit("palette: no such variant")
    try:
        meta = json.loads((SWEEP / "v" / key / "meta.json").read_text())
    except OSError:
        sys.exit("palette: no such variant")
    return Variant(meta["source"], tuple(meta["flags"]))


def sweep(variants):
    """Render every variant, collapse identical palettes within a source, and
    snapshot the rest.  Each variant owns its own directory."""
    with ThreadPoolExecutor(os.cpu_count()) as pool:
        errors = dict(zip(variants, pool.map(render_variant, variants)))
        first, same = {}, {}
        for v in variants:
            if errors[v] is None:
                body = (v.dir / "colorsets").read_bytes()
                if first.setdefault((v.source, body), v) is not v:
                    same[v] = first[(v.source, body)]
        todo = [v for v in variants if errors[v] is None and v not in same]
        errors.update(zip(todo, pool.map(snapshot, todo)))

    cells = []
    for v in variants:
        xres = v.dir / "Xresources"
        got = dict(XRES.findall(xres.read_text())) if xres.is_file() else {}
        cells.append({"key": v.key, "source": v.source, "label": source_label(v.source),
                      "flags": v.flags, "error": errors[v],
                      "same_as": same[v].flags if v in same else None,
                      "colors": [got[c].lower() for c in SCHEME[3:] if c in got]})
    return cells


def slug(cell):
    stem = Path(cell["label"]).stem if cell["source"] != LIVE else "live"
    return re.sub(r"[^\w-]+", "-", "-".join([stem] + [f.lstrip("-") for f in cell["flags"]])
                  ).strip("-")[:60] or "scheme"


def commands(cell):
    name = slug(cell)
    if cell["source"] == LIVE:
        return [f"palette save {name}"]
    src = shlex.quote(cell["source"])
    tail = f" -- {shlex.join(cell['flags'])}" if cell["flags"] else ""
    return [f"palette apply {src}{tail}", f"palette save {name} --from {src}{tail}"]


def grid_html(cells, url):
    esc = html.escape

    def flagtext(flags):
        return esc(" ".join(flags) or "wallust defaults")

    also = {}
    for c in cells:
        if c["same_as"] is not None:
            also.setdefault((c["source"], tuple(c["same_as"])), []).append(c["flags"])

    def card(c):
        if c["error"]:
            body = f'<div class=err>{esc(c["error"])}</div>'
        else:
            body = f'<img src="{esc(url(c["key"]))}" alt="{esc(c["label"])}">'
        strip = "".join(f'<i style="background:{x}" title="color{i} {x}"></i>'
                        for i, x in enumerate(c["colors"]))
        cmds = "".join(f'<input class=cmd readonly value="{esc(cmd)}">' for cmd in commands(c))
        dups = also.get((c["source"], tuple(c["flags"])), [])
        same = "".join(f"<code class=also>= {flagtext(f)}</code>" for f in dups)
        return (f'<div class=card><code class=flags>{flagtext(c["flags"])}</code>{same}{body}'
                f'<div class=strip>{strip}</div>{cmds}'
                f'<div class=save data-key={c["key"]}>'
                '<button type=button class=open>Save as scheme</button>'
                f'<span class=form hidden><input class=name value="{esc(slug(c))}" '
                'spellcheck=false aria-label="scheme name"><button type=button class=go>Save</button>'
                '<button type=button class=replace hidden>Replace</button></span>'
                '<span class=status></span></div></div>')

    groups = {}
    for c in cells:
        groups.setdefault(c["source"], []).append(c)
    distinct = sum(c["same_as"] is None for c in cells)
    out = [f'<p class=meta>{len(cells)} variants, {distinct} distinct · '
           f'{datetime.datetime.now():%Y-%m-%d %H:%M}</p>',
           "<div class=sweep>"]
    for source, group in groups.items():
        kind = "live palette" if source == LIVE else (
            "image" if is_image(source) else "scheme: flags do not apply")
        out.append(f'<section class=group><h2 title="{esc(source)}">{esc(group[0]["label"])} '
                   f'<small>{kind}</small></h2><div class=cards>'
                   + "".join(card(c) for c in group if c["same_as"] is None) + "</div></section>")
    out.append("</div>")
    return "\n".join(out)


def page(mode, grid=""):
    text = PAGE.read_text().replace("<!--grid-->", grid)
    return text.replace('<body data-mode="static">', f'<body data-mode="{mode}">')


def run_sweep(sources, vary, vs_live):
    _, variants = plan(sources, vary, vs_live)
    cells = sweep(variants)
    (SWEEP / "index.html").write_text(
        page("static", grid_html(cells, lambda key: f"v/{key}/panel.png")))
    return cells


def sweep_cmd(args):
    vary = parse_vary(args.vary, args.axis)
    if args.interactive:
        return serve(args, vary)
    run_sweep(args.sources, vary, args.vs == "live")
    print(f"Sweep: {SWEEP / 'index.html'}")


class Handler(BaseHTTPRequestHandler):
    server_version = "palette-sweep"

    def log_message(self, *a):
        pass

    def authed(self):
        query = dict(p.split("=", 1) for p in self.path.partition("?")[2].split("&") if "=" in p)
        token = self.headers.get("X-Token") or query.get("t", "")
        if secrets.compare_digest(token, self.server.token):
            return True
        self.send_error(403, "bad token")
        return False

    def reply(self, body, ctype="application/json", status=200):
        if isinstance(body, (dict, list)):
            body = json.dumps(body)
        body = body.encode() if isinstance(body, str) else body
        self.send_response(status)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def body(self):
        return self.rfile.read(int(self.headers.get("Content-Length", 0)))

    def do_GET(self):
        self.server.touch()
        path = self.path.split("?")[0]
        if path == "/":
            return self.reply(page("interactive"), "text/html; charset=utf-8")
        if not self.authed():
            return
        if path == "/api/config":
            return self.reply({
                "axes": {axis: list(values) for axis, values in axes().items()},
                "vary": self.server.vary, "vs_live": self.server.vs_live,
                "sources": self.server.sources, "max": MAX_VARIANTS,
                "schemes": sorted(p.stem for p in (ROOT / "schemes").glob("*.json"))})
        m = re.fullmatch(r"/v/([0-9a-f]{16})/panel\.png", path)
        if m and (SWEEP / "v" / m[1] / "panel.png").is_file():
            return self.reply((SWEEP / "v" / m[1] / "panel.png").read_bytes(), "image/png")
        self.send_error(404)

    def do_POST(self):
        self.server.touch()
        if not self.authed():
            return
        try:
            if self.path == "/api/upload":
                return self.reply(self.upload())
            data = json.loads(self.body())
            if self.path == "/api/sweep":
                with self.server.sweep_lock:
                    cells = run_sweep(data.get("sources", []),
                                               check_vary(data.get("vary", {})),
                                               bool(data.get("vs_live")))

                def url(key):
                    return f"/v/{key}/panel.png?t={self.server.token}"
                for c in cells:
                    c["png"] = None if c["error"] or c["same_as"] is not None else url(c["key"])
                return self.reply({"grid": grid_html(cells, url), "cells": cells})
            if self.path == "/api/save":
                v = variant_from_key(data.get("key"))
                path = save_variant(str(data.get("name", "")), v.source, v.flags,
                                    bool(data.get("force")))
                return self.reply({"ok": True, "path": str(path)})
            self.send_error(404)
        except SystemExit as e:
            self.reply({"error": str(e.code)}, status=400)

    def upload(self):
        name = Path(unquote(self.headers.get("X-Filename", ""))).name
        ext = Path(name).suffix.lower()
        if ext not in IMAGE_EXTS:
            sys.exit(f"palette: {name!r} is not an image ({', '.join(sorted(IMAGE_EXTS))})")
        data = self.body()
        UPLOADS.mkdir(parents=True, exist_ok=True)
        path = UPLOADS / f"{hashlib.sha256(data).hexdigest()[:24]}{ext}"
        if not path.exists():
            path.write_bytes(data)
        path.with_name(path.name + ".name").write_text(name)
        return source_info(str(path))


class Server(ThreadingHTTPServer):
    daemon_threads = True

    def __init__(self, addr, token, idle):
        super().__init__(addr, Handler)
        self.token = token
        self.idle = idle
        self.last = time.monotonic()
        self.sweep_lock = threading.Lock()

    def touch(self):
        self.last = time.monotonic()

    def watchdog(self):
        while self.idle:
            time.sleep(5)
            if time.monotonic() - self.last > self.idle:
                threading.Thread(target=self.shutdown, daemon=True).start()
                return


def serve(args, vary):
    try:
        srv = Server(("127.0.0.1", args.port), secrets.token_urlsafe(16), args.idle)
    except OSError:
        srv = Server(("127.0.0.1", 0), secrets.token_urlsafe(16), args.idle)
    srv.vary = vary
    srv.vs_live = args.vs == "live"
    srv.sources = [source_info(normal_source(s)) for s in args.sources]
    url = f"http://127.0.0.1:{srv.server_address[1]}/#{srv.token}"
    rundir = Path(os.environ.get("XDG_RUNTIME_DIR") or CACHE)
    urlfile = rundir / "palette-sweep.url"
    #  The URL carries the token, so it never lands world-readable.
    fd = os.open(urlfile, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(url)
    print(url, flush=True)
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    threading.Thread(target=srv.watchdog, daemon=True).start()
    if not args.no_browser:
        subprocess.Popen(["xdg-open", url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    try:
        srv.serve_forever()
    except (KeyboardInterrupt, SystemExit):
        pass
    finally:
        urlfile.unlink(missing_ok=True)


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    sub = parser.add_subparsers(required=True)
    for name, fn in (("preview", preview), ("apply", apply)):
        cmd = sub.add_parser(name)
        cmd.add_argument("source", help="scheme name, scheme .json, or image")
        cmd.add_argument("wallust", nargs="*", help="extra wallust args, after --")
        cmd.set_defaults(fn=fn)
    cmd = sub.add_parser("save", help="save the live palette, or a variant, as a named scheme")
    cmd.add_argument("name")
    cmd.add_argument("--from", dest="source", help="render this scheme or image instead of live")
    cmd.add_argument("wallust", nargs="*", help="extra wallust args for --from, after --")
    cmd.add_argument("--force", action="store_true", help="replace an existing scheme")
    cmd.set_defaults(fn=save)
    sub.add_parser("list", help="list saved schemes").set_defaults(fn=list_schemes)
    cmd = sub.add_parser("sweep", help="draw the shelf across sources and wallust flags")
    cmd.add_argument("sources", nargs="*", help="scheme names, scheme .json files, or images")
    cmd.add_argument("--vary", action="append", default=[], metavar="AXIS=V1,V2",
                     help=f"cross these values; axes: {', '.join(axes())}")
    cmd.add_argument("--axis", action="append", default=[], help="vary one axis across all its values")
    cmd.add_argument("--vs", choices=["live"], help="add the live palette, unchanged")
    cmd.add_argument("--interactive", action="store_true", help="serve a local page instead")
    cmd.add_argument("--port", type=int, default=8732)
    cmd.add_argument("--idle", type=int, default=1800, help="exit after N idle seconds (0 = never)")
    cmd.add_argument("--no-browser", action="store_true")
    cmd.set_defaults(fn=sweep_cmd)
    args = parser.parse_args()
    args.fn(args)


if __name__ == "__main__":
    main()
